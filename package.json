    "satori": "^0.25.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/sitemap": "^3.7.0",
    "@astrojs/tailwind": "^6.0.2",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "25.4.0",
    "@types/react": "19.2.14",
    "happy-dom": "20.11.2",
    "js-yaml": "^4.1.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3"
