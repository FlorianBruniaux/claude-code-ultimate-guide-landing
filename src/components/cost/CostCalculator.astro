---
import { DEFAULT_SCENARIO, PRICES_READ_DATE, formatUsd, priceRows, tierLabel } from '../../data/llm-prices'

const rows = priceRows(DEFAULT_SCENARIO)
const visible = rows.filter((r) => r.price.tier !== 'off-peak')
const max = Math.max(...visible.map((r) => r.perDay), 0.0001)
const s = DEFAULT_SCENARIO

interface Props {
  /** Render inside a page section that already has its own h2. */
  nested?: boolean
}
const { nested = false } = Astro.props
const Heading = nested ? 'h3' : 'h2'
---

<section class="cost-calc" data-cost-calc aria-labelledby="cost-calc-title">
  <Heading id="cost-calc-title" class="cost-calc__title">{nested ? 'Try your own numbers' : 'LLM cost calculator'}</Heading>

  <form class="cost-calc__form" onsubmit="return false">
    <div class="cost-calc__field">
      <label for="cc-input">Input tokens per day (millions)</label>
      <div class="cost-calc__pair">
        <input type="range" id="cc-input-range" min="0" max="200" step="0.5" value={s.inputMTokPerDay} aria-label="Input tokens per day, slider" data-link="cc-input" />
        <input type="number" id="cc-input" name="input" min="0" step="any" inputmode="decimal" value={s.inputMTokPerDay} data-range="cc-input-range" />
      </div>
    </div>
    <div class="cost-calc__field">
      <label for="cc-cache">Cache hit share (%)</label>
      <div class="cost-calc__pair">
        <input type="range" id="cc-cache-range" min="0" max="100" step="1" value={s.cacheHitPercent} aria-label="Cache hit share, slider" data-link="cc-cache" />
        <input type="number" id="cc-cache" name="cache" min="0" max="100" step="any" inputmode="decimal" value={s.cacheHitPercent} data-range="cc-cache-range" />
      </div>
    </div>
    <div class="cost-calc__field">
      <label for="cc-output">Output tokens per day (millions)</label>
      <div class="cost-calc__pair">
        <input type="range" id="cc-output-range" min="0" max="20" step="0.1" value={s.outputMTokPerDay} aria-label="Output tokens per day, slider" data-link="cc-output" />
        <input type="number" id="cc-output" name="output" min="0" step="any" inputmode="decimal" value={s.outputMTokPerDay} data-range="cc-output-range" />
      </div>
    </div>
    <div class="cost-calc__field">
      <label for="cc-days">Working days per month</label>
      <div class="cost-calc__pair">
        <input type="range" id="cc-days-range" min="1" max="31" step="1" value={s.workingDaysPerMonth} aria-label="Working days per month, slider" data-link="cc-days" />
        <input type="number" id="cc-days" name="days" min="1" max="31" step="1" inputmode="numeric" value={s.workingDaysPerMonth} data-range="cc-days-range" />
      </div>
    </div>
    <label class="cost-calc__toggle" for="cc-offpeak" data-js-only hidden>
      <input type="checkbox" id="cc-offpeak" />
      <span>Show off-peak rows (DeepSeek)</span>
    </label>
  </form>

  <div class="cost-calc__results" role="region" aria-live="polite" aria-atomic="false" aria-label="Cost results">
    <ol class="cost-calc__list" data-list>
      {rows.map((r) => {
        const offPeak = r.price.tier === 'off-peak'
        const label = tierLabel(r.price.tier)
        return (
          <li class="cost-calc__row" data-id={r.price.id} hidden={offPeak}>
            <div class="cost-calc__head">
              <a class="cost-calc__name" href={r.price.sourceUrl} target="_blank" rel="noopener noreferrer">
                <span class="cost-calc__vendor">{r.price.vendor}</span> {r.price.model}{label ? ` ${label}` : ''}
              </a>
              <span class="cost-calc__amounts">
                <span><strong data-day>{formatUsd(r.perDay)}</strong> / day</span>
                <span><strong data-month>{formatUsd(r.perMonth)}</strong> / month</span>
              </span>
            </div>
            <div class="cost-calc__bar" aria-hidden="true">
              <span data-bar style={`width:${Math.max(0.5, (r.perDay / max) * 100).toFixed(2)}%`} class:list={[{ 'is-upper': r.upperBound }]}></span>
            </div>
            {r.upperBound && <p class="cost-calc__note">Upper bound, no cached price published</p>}
          </li>
        )
      })}
    </ol>
  </div>

  <p class="cost-calc__meta">Prices read {PRICES_READ_DATE}; token counts differ between tokenizers, so the same text does not produce the same token count on every model.</p>
  <p class="cost-calc__meta">This table compares bills for the same token count, not work done. Standard tier, USD per 1M tokens, cache writes excluded.</p>
</section>

<script>
  import { LLM_PRICES, formatUsd, priceRows } from '../../data/llm-prices'

  const root = document.querySelector<HTMLElement>('[data-cost-calc]')
  if (root) {
    const $ = <T extends HTMLElement>(id: string) => root.querySelector<T>('#' + id)!
    const list = root.querySelector<HTMLOListElement>('[data-list]')!
    const offPeak = $<HTMLInputElement>('cc-offpeak')
    root.querySelector<HTMLElement>('[data-js-only]')!.hidden = false

    const num = (el: HTMLInputElement, fallback: number) => {
      const v = parseFloat(el.value)
      return Number.isFinite(v) && v >= 0 ? v : fallback
    }

    const update = () => {
      const scenario = {
        inputMTokPerDay: num($('cc-input'), 0),
        cacheHitPercent: Math.min(100, num($('cc-cache'), 0)),
        outputMTokPerDay: num($('cc-output'), 0),
        workingDaysPerMonth: Math.min(31, num($('cc-days'), 0)),
      }
      const rows = priceRows(scenario, { includeOffPeak: offPeak.checked, prices: LLM_PRICES })
      const max = Math.max(...rows.map((r) => r.perDay), 0)
      const shown = new Set(rows.map((r) => r.price.id))
      const items = new Map(Array.from(list.children).map((li) => [(li as HTMLElement).dataset.id!, li as HTMLElement]))
      for (const r of rows) {
        const li = items.get(r.price.id)!
        li.hidden = false
        li.querySelector('[data-day]')!.textContent = formatUsd(r.perDay)
        li.querySelector('[data-month]')!.textContent = formatUsd(r.perMonth)
        li.querySelector<HTMLElement>('[data-bar]')!.style.width = (max > 0 ? Math.max(0.5, (r.perDay / max) * 100) : 0.5).toFixed(2) + '%'
        list.appendChild(li)
      }
      items.forEach((li, id) => { if (!shown.has(id)) li.hidden = true })
    }

    root.querySelectorAll<HTMLInputElement>('input[data-link]').forEach((range) => {
      const field = $<HTMLInputElement>(range.dataset.link!)
      range.addEventListener('input', () => { field.value = range.value; update() })
    })
    root.querySelectorAll<HTMLInputElement>('input[data-range]').forEach((field) => {
      const range = $<HTMLInputElement>(field.dataset.range!)
      field.addEventListener('input', () => { range.value = field.value; update() })
    })
    offPeak.addEventListener('change', update)
    update()
  }
</script>

<style>
  .cost-calc { border: 1px solid var(--border); background: var(--surface-elevated); border-radius: var(--border-radius-lg); padding: var(--space-lg); color: var(--text-primary); max-width: 100%; }
  .cost-calc__title { margin: 0 0 var(--space-md); font-size: 1.25rem; }
  .cost-calc__form { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: var(--space-md); margin-bottom: var(--space-lg); }
  .cost-calc__field { display: flex; flex-direction: column; gap: var(--space-xs); min-width: 0; }
  .cost-calc__field label { font-size: 0.85rem; color: var(--text-secondary); }
  .cost-calc__pair { display: grid; grid-template-columns: minmax(0, 1fr) 5.5rem; gap: var(--space-sm); align-items: center; }
  .cost-calc input[type='range'] { width: 100%; accent-color: var(--accent); min-width: 0; }
  .cost-calc input[type='number'] { width: 100%; box-sizing: border-box; font-family: var(--font-mono); padding: var(--space-xs) var(--space-sm); border: 1px solid var(--border); border-radius: var(--border-radius); background: var(--bg-tertiary); color: var(--text-primary); }
  .cost-calc input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .cost-calc__toggle { display: flex; align-items: center; gap: var(--space-sm); font-size: 0.9rem; color: var(--text-secondary); grid-column: 1 / -1; }
  .cost-calc__toggle[hidden], .cost-calc__row[hidden] { display: none; }
  .cost-calc__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-md); }
  .cost-calc__head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-xs) var(--space-md); align-items: baseline; }
  .cost-calc__name { color: var(--text-primary); text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .cost-calc__name:hover, .cost-calc__name:focus-visible { color: var(--accent); text-decoration-color: var(--accent); }
  .cost-calc__vendor { color: var(--text-muted); }
  .cost-calc__amounts { display: flex; gap: var(--space-md); font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-secondary); font-variant-numeric: tabular-nums; }
  .cost-calc__amounts strong { color: var(--text-primary); }
  .cost-calc__bar { height: 10px; background: var(--bg-tertiary); border-radius: 999px; overflow: hidden; margin-top: var(--space-xs); }
  .cost-calc__bar span { display: block; height: 100%; background: var(--accent); border-radius: 999px; transition: width 0.2s ease; }
  .cost-calc__bar span.is-upper { background: repeating-linear-gradient(45deg, var(--accent) 0 6px, var(--bg-tertiary) 6px 9px); box-shadow: inset 0 0 0 1px var(--accent); }
  .cost-calc__note { margin: var(--space-xs) 0 0; font-size: 0.8rem; color: var(--text-muted); font-style: italic; }
  .cost-calc__meta { margin: var(--space-md) 0 0; font-size: 0.8rem; color: var(--text-muted); }
  @media (prefers-reduced-motion: reduce) { .cost-calc__bar span { transition: none; } }
  @media (max-width: 480px) { .cost-calc { padding: var(--space-md); } }
</style>
