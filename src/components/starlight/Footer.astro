---
/**
 * Starlight Footer override.
 *
 * Starlight renders this inside the content column (between left nav and right TOC).
 * We use an inline script to move it to <body> level so it escapes the flex layout
 * and spans full viewport width, same as on landing pages.
 *
 * Starlight's own footer renders the previous/next links; the override keeps
 * them in the content column, before the portal (UX-05).
 */
import Pagination from '@astrojs/starlight/components/Pagination.astro'
import GlobalFooter from '../global/Footer.astro'
---
<div class="guide-pagination">
  <Pagination />
</div>

<div id="sl-footer-portal" class="sl-footer-portal">
  <GlobalFooter showGuideCta={false} />
</div>

<script is:inline>
  ;(function () {
    var el = document.getElementById('sl-footer-portal')
    if (el) {
      el.removeAttribute('id')
      document.body.appendChild(el)
    }
  })()
</script>

<script>
  // UX-12: a table wider than the reading column scrolls sideways; make it
  // reachable with the keyboard, but only when it actually overflows.
  function markScrollableTables() {
    for (const table of document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table')) {
      if (table.scrollWidth > table.clientWidth + 1) table.tabIndex = 0
      else table.removeAttribute('tabindex')
    }
  }
  markScrollableTables()
  window.addEventListener('resize', markScrollableTables, { passive: true })
</script>

<style>
  .guide-pagination {
    margin-top: 3rem;
  }

  /* Portfolio card contract: border, 8 px radius, no soft shadow. */
  .guide-pagination :global(.pagination-links a) {
    border: 1px solid var(--border);
    border-radius: var(--border-radius-lg);
    background: var(--surface-elevated);
    box-shadow: none;
    color: var(--text-primary);
  }

  .guide-pagination :global(.pagination-links a:is(:hover, :focus-visible)) {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent), 4px 4px 0 var(--border);
  }
</style>
