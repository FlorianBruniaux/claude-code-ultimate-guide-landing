---
/**
 * Starlight Header override.
 * Renders the site-wide header, search modal, feedback button, and guide-page actions.
 * This replaces Starlight's default header entirely.
 */
import GlobalHeader from '../global/Header.astro'
import SearchModal from '../global/SearchModal.astro'
import FeedbackFab from '../global/FeedbackFab.astro'
import GuidePageFab from '../global/GuidePageFab.astro'
---
<GlobalHeader />
<SearchModal />
<GuidePageFab />
<FeedbackFab />

<script>
  const guideMenu = document.querySelector('starlight-menu-button')
  const guideMenuButton = guideMenu?.querySelector<HTMLButtonElement>(
    'button[aria-controls="starlight__sidebar"]'
  )

  if (guideMenu && guideMenuButton) {
    const syncGuideMenuState = () => {
      guideMenuButton.setAttribute(
        'aria-expanded',
        guideMenu.getAttribute('aria-expanded') === 'true' ? 'true' : 'false'
      )
    }

    syncGuideMenuState()
    new MutationObserver(syncGuideMenuState).observe(guideMenu, {
      attributes: true,
      attributeFilter: ['aria-expanded'],
    })
  }

  // Markdown tables scroll inside the reading column (display: block; overflow-x: auto).
  // Only those wider than the column get a tab stop, so keyboard users can scroll them.
  function focusScrollableTables() {
    document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table').forEach((table) => {
      if (table.scrollWidth > table.clientWidth) {
        table.tabIndex = 0
      } else if (table.tabIndex === 0) {
        table.removeAttribute('tabindex')
      }
    })
  }

  // AM-04: one rule for GitHub links in guide prose, they open in a new tab.
  document
    .querySelectorAll<HTMLAnchorElement>('.sl-markdown-content a[href^="https://github.com/"]:not([target])')
    .forEach((link) => {
      link.target = '_blank'
      link.rel = 'noopener noreferrer'
    })

  focusScrollableTables()
  let tableResizeFrame = 0
  window.addEventListener('resize', () => {
    cancelAnimationFrame(tableResizeFrame)
    tableResizeFrame = requestAnimationFrame(focusScrollableTables)
  })
</script>
