---
import HeroBlogPosts from './HeroBlogPosts.astro'
import HeroQuickGuides from './HeroQuickGuides.astro'
---

<section class="section latest" aria-labelledby="latest-title">
  <div class="container">
    <p class="section-kicker">Latest writing</p>
    <h2 class="section-title" id="latest-title">What changed, and what I learned</h2>
    <p class="section-subtitle">Recent essays and focused guides from Florian Bruniaux.</p>
    <div class="latest-grid">
      <HeroBlogPosts />
      <HeroQuickGuides />
    </div>
  </div>
</section>

<style>
  .section-kicker { margin: 0 0 0.35rem; color: var(--accent); font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .latest-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 5vw, 4rem); padding-top: 0.25rem; }
  @media (max-width: 720px) { .latest-grid { grid-template-columns: 1fr; } }
</style>
