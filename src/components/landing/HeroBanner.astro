---
import AuthorProfile from './AuthorProfile.astro'
import { getSiteStats } from '../../utils/site-stats'
import { HOMEPAGE_METRICS } from '../../data/homepage-content'

const stats = await getSiteStats()
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-copy">
      <p class="hero-kicker">Free, open source, and built from real workflows</p>
      <div class="hero-heading">
        <img src="/claude-logo-orange.svg" alt="" class="hero-logo" width="50" height="50" fetchpriority="high" loading="eager">
        <h1 id="hero-title">Claude Code Ultimate Guide</h1>
      </div>

      <div class="hero-body">
        <p class="hero-tagline">Go from your first command to production-ready Claude Code workflows.</p>
        <p class="hero-support">Security, testing, team adoption, and reusable templates, with the trade-offs explained.</p>

        <div class="hero-actions">
          <a href="#start-here" class="btn btn-primary">Start in 15 min</a>
          <a href="/guide/" class="btn btn-secondary">Browse the full guide</a>
          <a href="/downloads/" class="hero-download-link">Downloads ↓</a>
        </div>
      </div>

      <div class="hero-evidence">
        <div class="proof-strip" aria-label="Guide highlights">
          <a href="https://github.com/FlorianBruniaux/claude-code-ultimate-guide" target="_blank" rel="noopener" class="proof-item proof-stars">
            <span aria-hidden="true">★</span>
            <strong class="proof-value">5.9k</strong>
            <span>GitHub stars</span>
          </a>
          <a href="/examples/" class="proof-item">
            <strong>{stats.templateCount}</strong>
            <span>templates</span>
          </a>
          <a href="/security/" class="proof-item">
            <strong>{stats.cveCount}</strong>
            <span>CVEs tracked</span>
          </a>
          <a href="/resources/" class="proof-item proof-item--optional">
            <strong>{HOMEPAGE_METRICS.recapCardCount}</strong>
            <span>recap cards</span>
          </a>
        </div>

        <AuthorProfile />
      </div>
    </div>
  </div>
</section>

<script>
  async function loadStars() {
    try {
      const response = await fetch('https://api.github.com/repos/FlorianBruniaux/claude-code-ultimate-guide')
      if (!response.ok) return
      const data = await response.json()
      const stars = Number(data.stargazers_count)
      const starsEl = document.querySelector('.proof-stars .proof-value')
      if (starsEl && stars > 0) {
        starsEl.textContent = stars >= 1000
          ? `${(stars / 1000).toFixed(1).replace(/\.0$/, '')}k`
          : String(stars)
      }
    } catch {
      // The visible fallback keeps the proof readable when GitHub is unavailable.
    }
  }

  loadStars()
</script>

<style>
  .hero {
    padding: clamp(3rem, 7vw, 5.5rem) 0 2rem;
    background:
      radial-gradient(circle at 85% 10%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 32rem),
      linear-gradient(155deg, var(--bg-secondary), var(--bg-primary) 64%);
    border-bottom: 1px solid var(--border);
  }

  .hero .container { max-width: 1440px; }

  .hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(320px, 0.8fr);
    grid-template-areas:
      "kicker kicker"
      "heading heading"
      "body evidence";
    column-gap: clamp(2.5rem, 6vw, 6rem);
  }

  .hero-kicker {
    grid-area: kicker;
    margin: 0 0 0.85rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .hero-heading {
    grid-area: heading;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hero-logo {
    width: clamp(40px, 5vw, 52px);
    height: auto;
    flex: 0 0 auto;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.45rem, 6vw, 4.7rem);
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .hero-body {
    grid-area: body;
    min-width: 0;
  }

  .hero-tagline {
    max-width: 780px;
    margin: 1.5rem 0 0;
    color: var(--text-primary);
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
    font-weight: 600;
    line-height: 1.35;
  }

  .hero-support {
    max-width: 700px;
    margin: 0.55rem 0 0;
    color: var(--text-secondary);
    font-size: 1rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero-actions .btn { min-height: 46px; }

  .hero-download-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.55rem;
    font-weight: 650;
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .hero-evidence {
    grid-area: evidence;
    align-self: end;
    min-width: 0;
    margin-top: 1.5rem;
  }

  .proof-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 38px;
    padding: 0.45rem 0.7rem;
    color: var(--text-secondary) !important;
    background: color-mix(in srgb, var(--surface-elevated) 72%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.825rem;
    line-height: 1;
    text-decoration: none !important;
  }

  .proof-item strong {
    color: var(--text-primary);
    font-family: var(--font-mono);
  }

  .proof-item:hover { border-color: var(--accent); }

  @media (max-width: 1100px) {
    .hero-copy {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "kicker"
        "heading"
        "body"
        "evidence";
    }

    .hero-evidence { max-width: 900px; }

    .proof-strip {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 640px) {
    .hero { padding: 2.75rem 0 1.5rem; }
    .hero-heading { align-items: flex-start; gap: 0.65rem; }
    h1 { font-size: clamp(2.2rem, 12vw, 3.25rem); }
    .hero-tagline { margin-top: 1.1rem; }
    .hero-actions { align-items: stretch; }
    .hero-actions .btn { flex: 1 1 100%; }
    .hero-download-link { justify-content: center; width: 100%; }
    .proof-strip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proof-item { justify-content: center; }
  }
</style>
