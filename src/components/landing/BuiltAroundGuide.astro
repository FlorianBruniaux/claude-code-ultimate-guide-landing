---
import { FEATURED_PROJECTS, RELATED_PROJECTS } from '../../data/homepage-content'
import { isComingSoon } from '../../data/ecosystem-discovery'
import SoonBadge from '../ecosystem/SoonBadge.astro'

// Merges the former "Community & resources" and companion tools sections:
// one place for what is built around the guide and how to take part.
import ChapterLabel from '../global/ChapterLabel.astro'
---

<section class="section band band-paper section-wallpaper built-around" id="related" aria-labelledby="built-title">
  <div class="container">
    <div class="section-header">
      <div>
        <ChapterLabel number="04" label="Built around the guide" />
        <h2 class="section-title" id="built-title">Companion tools and an open community</h2>
      </div>
      <a class="btn btn-primary" href="/projects/">See all {RELATED_PROJECTS.length} projects →</a>
    </div>

    <div class="related-grid">
      {FEATURED_PROJECTS.map((project) => (
        <a
          href={project.href}
          class="related-card brand-card brand-interactive-card"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${project.title}${isComingSoon(project) ? ', coming soon' : ''} (opens in a new tab)`}
          data-ecosystem-project-id={project.id}
          data-ecosystem-placement="homepage"
          data-ecosystem-menu="none"
        >
          <span class="related-icon" aria-hidden="true">{project.icon}</span>
          <div>
            <h3>{project.title} {isComingSoon(project) && <SoonBadge />}</h3>
            <p>{project.description}</p>
          </div>
          <span class="related-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>

    <div class="community-grid" id="community">
      <a
        class="community-card brand-card brand-interactive-card"
        href="https://github.com/FlorianBruniaux/claude-code-ultimate-guide/blob/main/CONTRIBUTING.md"
        target="_blank"
        rel="noopener"
      >
        <span class="community-icon" aria-hidden="true">📝</span>
        <span>
          <strong>Contribute to the guide</strong>
          <span class="community-desc">Found an error or have a better template? The guide is open source.</span>
        </span>
        <span class="community-link">Contributing guide <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span>
      </a>
      <a
        class="community-card brand-card brand-interactive-card"
        href="https://github.com/FlorianBruniaux/claude-code-ultimate-guide"
        target="_blank"
        rel="noopener"
      >
        <span class="community-icon" aria-hidden="true">⭐</span>
        <span>
          <strong>Star on GitHub</strong>
          <span class="community-desc">If the guide saved you time, show your support.</span>
        </span>
        <span class="community-link">GitHub repository <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .section-kicker { margin: 0 0 0.35rem; color: var(--accent); font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .section-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .section-header .section-title { margin-bottom: 0; }
  .all-link { display: inline-flex; align-items: center; min-height: 44px; flex: 0 0 auto; font-weight: 650; }
  .related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .related-card { display: grid; grid-template-columns: auto 1fr auto; gap: 0.85rem; min-height: 130px; padding: 1rem; color: var(--text-primary) !important; background: var(--surface-elevated); border: 1px solid var(--border); border-radius: var(--border-radius-lg); text-decoration: none !important; transition: border-color var(--transition-fast), box-shadow var(--transition-fast); }
  /* .related-card hover comes from .brand-interactive-card (portfolio). */
  .related-icon { font-size: 1.2rem; }
  .related-card h3 { margin: 0; font-size: 0.95rem; }
  .related-card p { margin: 0.35rem 0 0; color: var(--text-secondary); font-size: 0.8rem; }
  .related-arrow { color: var(--accent); }

  .community-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin-top: 1rem; }
  .community-card { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 0.85rem; padding: 0.9rem 1rem; color: var(--text-primary) !important; background: var(--surface-elevated); border: 1px solid var(--border); border-radius: var(--border-radius-lg); text-decoration: none !important; transition: border-color var(--transition-fast), box-shadow var(--transition-fast); }
  .community-icon { font-size: 1.2rem; }
  .community-card strong { display: block; font-size: 0.95rem; }
  .community-desc { display: block; margin-top: 0.2rem; color: var(--text-secondary); font-size: 0.82rem; }
  .community-link { color: var(--accent); font-size: 0.85rem; font-weight: 600; white-space: nowrap; }

  @media (max-width: 1100px) { .related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 820px) {
    .related-grid,
    .community-grid { grid-template-columns: 1fr; }
    .community-card { grid-template-columns: auto 1fr; }
    .community-link { grid-column: 2; }
  }
  @media (max-width: 600px) { .section-header { align-items: flex-start; flex-direction: column; } }
</style>
