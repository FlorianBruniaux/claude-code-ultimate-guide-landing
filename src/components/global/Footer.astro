---
import SoonBadge from '../ecosystem/SoonBadge.astro'
import { getFooterEcosystemProjects } from '../../data/footer-ecosystem'

interface Props {
  compact?: boolean
}

const { compact = false } = Astro.props

// Sentence case everywhere: only the first word, product names and acronyms
// keep a capital, so the columns read as one list.
const footerLinks = {
  documentation: [
    { href: 'https://github.com/FlorianBruniaux/claude-code-ultimate-guide/blob/main/guide/ultimate-guide.md', label: 'Ultimate guide', external: true },
    { href: '/mcp/', label: 'MCP server' },
    { href: '/guide/translations/', label: 'Translations' },
    { href: '/cheatsheet/', label: 'Quick reference' },
    { href: '/cheatsheets/', label: 'Recap cards' },
    { href: '/whitepapers/', label: 'Ebooks (PDF)' },
    { href: '/guide/architecture/', label: 'Architecture' },
    { href: '/guide/data-privacy/', label: 'Data privacy' },
  ],
  resources: [
    { href: '/quiz/', label: 'Quiz' },
    { href: '/learning/', label: 'Learning' },
    { href: '/roles/', label: 'AI roles' },
    { href: '/methodologies/', label: 'Methodologies' },
    { href: '/diagrams/', label: 'Diagrams' },
    { href: '/security/', label: 'Security' },
    { href: '/examples/', label: 'Examples' },
    { href: '/compare/', label: 'Compare' },
    { href: '/changelog/', label: 'Guide changelog' },
    { href: '/releases/', label: 'Claude Code releases' },
    { href: '/context/', label: 'Context' },
    { href: '/context-engineering/', label: 'Context engineering tools' },
    { href: '/team-metrics/', label: 'Team metrics' },
    { href: '/ecosystem/', label: 'Ecosystem' },
    { href: '/faq/', label: 'FAQ' },
    { href: '/glossary/', label: 'Glossary' },
    { href: 'https://github.com/FlorianBruniaux/claude-code-ultimate-guide/blob/main/machine-readable/reference.yaml', label: 'LLM reference', external: true },
  ],
  community: [
    { href: 'https://github.com/FlorianBruniaux/claude-code-ultimate-guide', label: 'GitHub repo', external: true },
    { href: 'https://github.com/FlorianBruniaux/claude-code-ultimate-guide/blob/main/CONTRIBUTING.md', label: 'Contribute', external: true },
    { href: 'https://github.com/FlorianBruniaux/claude-code-ultimate-guide/issues', label: 'Report issues', external: true },
    { href: 'https://www.devw.ai/', label: 'Dev with AI (FR)', external: true },
    { href: 'https://twitter.com/intent/tweet?url=https://cc.bruniaux.com/&text=Claude%20Code%20Guide%20-%20Master%20AI-powered%20coding', label: 'Share on X', external: true },
    { href: 'https://www.linkedin.com/sharing/share-offsite/?url=https://cc.bruniaux.com/', label: 'Share on LinkedIn', external: true },
    { href: 'https://www.florian.bruniaux.com/', label: 'Blog and portfolio', external: true },
  ],
}

// Read from the profile manifest, like the menu strips, so a new project shows
// up here without editing the footer. Names keep their lowercase repo form.
const ecosystemProjects = getFooterEcosystemProjects()
---

<footer class:list={["border-t border-border bg-background-secondary", compact ? 'mt-12' : 'mt-24']}>
  <div class:list={["mx-auto max-w-content px-4", compact ? 'py-8' : 'py-12']}>
    {compact && (
      <div class="compact-footer">
        <a href="/" class="compact-brand">
          <svg height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-2.266-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.358-1.596-2.552-1.688-1.336-.972-.724-.491-.364-.462-.158-1.008.656-.722.881.06.225.061.893.686 1.908 1.476 2.491 1.833.365.304.145-.103.019-.073-.164-.274-1.355-2.446-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 01-.104-.729L6.283.134 6.696 0l.996.134.42.364.62 1.414 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.264 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.205-1.657-.851-.747-1.926-1.62h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.012-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312-.006.006z" fill="#D97757" fill-rule="nonzero"/></svg>
          <span>Claude Code Guide</span>
        </a>
        <nav class="compact-links" aria-label="Footer links">
          <a href="/guide/">Guide</a>
          <a href="/mcp/">MCP</a>
          <a href="/resources/">Resources</a>
          <a href="/downloads/">Downloads</a>
          <a href="/projects/">Projects</a>
          <a href="https://www.florian.bruniaux.com/blog/" target="_blank" rel="noopener noreferrer">Blog ↗</a>
        </nav>
      </div>
    )}

    {!compact && (
      <>
    <!-- Footer CTA -->
    <div class="mb-10 pb-10 border-b border-border">
      <h3 class="text-xl font-bold text-text-primary mb-2">Ready to master Claude Code?</h3>
      <p class="text-text-secondary mb-4">Start with the free, open-source Claude Code guide.</p>
      <a
        href="https://github.com/FlorianBruniaux/claude-code-ultimate-guide"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-5 py-2.5 rounded-lg bg-accent text-white font-medium hover:bg-accent-hover transition-colors"
      >
        Read the Guide &rarr;
      </a>
    </div>

    <!-- Footer Grid -->
    <div class="grid grid-cols-2 md:grid-cols-6 gap-8 mb-8">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-3 hover:opacity-80 transition-opacity">
          <svg height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-2.266-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.358-1.596-2.552-1.688-1.336-.972-.724-.491-.364-.462-.158-1.008.656-.722.881.06.225.061.893.686 1.908 1.476 2.491 1.833.365.304.145-.103.019-.073-.164-.274-1.355-2.446-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 01-.104-.729L6.283.134 6.696 0l.996.134.42.364.62 1.414 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.264 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.205-1.657-.851-.747-1.926-1.62h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.012-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312-.006.006z" fill="#D97757" fill-rule="nonzero"/></svg>
          <span class="text-text-primary font-semibold text-sm">Code Guide</span>
        </a>
        <p class="text-text-muted text-sm leading-relaxed">
          Claude Code from beginner to power user.
        </p>
      </div>

      {Object.entries(footerLinks).map(([section, links]) => (
        <div>
          <h3 class="text-sm font-semibold text-text-primary mb-3 uppercase tracking-wide">
            {section.charAt(0).toUpperCase() + section.slice(1)}
          </h3>
          <ul class="space-y-2">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-text-muted hover:text-accent transition-colors"
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="col-span-2">
        <h3 class="text-sm font-semibold text-text-primary mb-3 uppercase tracking-wide">Ecosystem</h3>
        <ul class="footer-ecosystem">
          {ecosystemProjects.map((project) => (
            <li>
              <a
                href={project.href}
                class="text-sm text-text-muted hover:text-accent transition-colors"
                target="_blank"
                rel="noopener noreferrer"
                title={project.title}
              >
                {project.label}
              </a>
              {project.soon && <SoonBadge />}
            </li>
          ))}
        </ul>
      </div>
    </div>
      </>
    )}

    <!-- Bottom bar -->
    <div class="border-t border-border pt-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-text-muted">
        <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover transition-colors">CC BY-SA 4.0</a> &bull;
        AI engineering consulting by <a href="https://www.florian.bruniaux.com/?utm_source=cc-guide&utm_medium=footer&utm_campaign=consulting" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover transition-colors">Florian BRUNIAUX</a>
        &bull;
        <a href="https://github.com/FlorianBruniaux" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover transition-colors">GitHub</a>
      </p>
      <p class="text-xs text-text-muted flex items-center gap-3 flex-wrap justify-end">
        <a href="/sitemap/" class="text-text-muted hover:text-accent transition-colors">All pages</a>
        <span aria-hidden="true">&middot;</span>
        <a href="/rss.xml" class="text-text-muted hover:text-accent transition-colors" aria-label="RSS Feed" title="RSS Feed">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:inline-block;vertical-align:-2px"><path d="M6.18 15.64a2.18 2.18 0 010 4.36 2.18 2.18 0 010-4.36M4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44m0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z"/></svg>
        </a>
        <span aria-hidden="true">&middot;</span>
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover transition-colors">Astro</a> &middot;
        Deployed on <a href="https://pages.github.com" target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent-hover transition-colors">GitHub Pages</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .compact-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .compact-brand,
  .compact-links {
    display: flex;
    align-items: center;
  }

  .compact-brand {
    gap: 0.55rem;
    min-height: 44px;
    color: var(--text-primary) !important;
    font-weight: 700;
    text-decoration: none !important;
  }

  .compact-links {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem 1.2rem;
  }

  .compact-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .footer-ecosystem {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem 1.5rem;
  }

  .footer-ecosystem li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 720px) {
    .compact-footer { align-items: flex-start; flex-direction: column; }
    .compact-links { justify-content: flex-start; }
  }
</style>
