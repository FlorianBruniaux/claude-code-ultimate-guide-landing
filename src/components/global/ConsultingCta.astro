---
/**
 * Reusable "work with me" CTA, placed on a deliberately short list of
 * high-traffic / high-intent pages (not sitewide, see Footer.astro for the
 * discreet always-on version). `placement` feeds utm_content so click-through
 * can be measured per page in GA4/GSC instead of guessed.
 */
interface Props {
  heading?: string
  body?: string
  placement: string
}

const {
  heading = "Need this in production, not just in a guide?",
  body = "I do AI engineering consulting: agent architecture, Claude Code adoption for teams, and getting agentic workflows from demo to production.",
  placement,
} = Astro.props

const contactUrl = `https://www.florian.bruniaux.com/contact/?utm_source=cc-guide&utm_medium=cta&utm_campaign=consulting&utm_content=${placement}`
---

<div class:list={["consulting-cta", placement === 'homepage' && "band band-accent section-wallpaper consulting-cta--band"]}>
  <div class="container">
    <div class:list={["consulting-cta-inner", placement === 'homepage' && "brand-card brand-card-emphasis"]}>
      <div class="consulting-cta-text">
        <h3>{heading}</h3>
        <p>{body}</p>
      </div>
      <div class="consulting-cta-actions">
        <a href={contactUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Let's talk &rarr;</a>
        <a href="https://github.com/FlorianBruniaux" target="_blank" rel="noopener noreferrer" class="consulting-cta-github">See the code on GitHub</a>
        {placement === 'homepage' && <>
          <a href="https://www.florian.bruniaux.com/services/training/?utm_source=cc-guide&amp;utm_medium=cta&amp;utm_campaign=harness-training#cohort" class="consulting-cta-github">Get Claude Code and Codex training dates</a>
          <a href="https://www.florian.bruniaux.com/newsletter/?utm_source=cc-guide&amp;utm_medium=cta&amp;utm_campaign=newsletter#newsletter" class="consulting-cta-github">Subscribe to Florian’s newsletter</a>
        </>}
      </div>
    </div>
  </div>
</div>

<style>
  .consulting-cta {
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--border);
  }
  .consulting-cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--border-radius-lg);
    padding: var(--space-xl);
  }
  .consulting-cta-text h3 {
    font-size: 1.1rem;
    margin-bottom: var(--space-xs);
    color: var(--text-primary);
  }
  .consulting-cta-text p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 52ch;
  }
  .consulting-cta-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    /* May shrink and wrap: with four links the row is 801 px wide and pushed
     * the page sideways between 641 and 849 px (CX-05, UX-03). */
    flex: 0 1 auto;
    min-width: 0;
  }
  /* Discreet action level: underlined at rest, stroke thickens on hover. */
  .consulting-cta-github {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9rem;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.24em;
  }
  .consulting-cta-github:hover {
    color: var(--accent-hover);
    text-decoration-thickness: 2px;
  }
  .consulting-cta--band {
    padding: var(--space-4xl) 0;
    border-top: 0;
  }
  @media (max-width: 640px) {
    .consulting-cta-inner { flex-direction: column; align-items: flex-start; }
    .consulting-cta-actions { width: 100%; }
  }
</style>
