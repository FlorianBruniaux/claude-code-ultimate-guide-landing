---
import ThemeToggle from './ThemeToggle.astro'
import EcosystemProjectStrip from '../ecosystem/EcosystemProjectStrip.astro'
import { ecosystemMenuProjects } from '../../data/ecosystem-discovery'
import {
  allPagesLink,
  getActiveNavigation,
  getFurtherSpans,
  getHeaderActionLinks,
  getSectionPageCount,
  guideNavigationLink,
  navigationSections,
} from '../../data/header-navigation'
import type { HeaderNavigationLink } from '../../data/header-navigation'
import { sitemapSectionHref } from '../../data/sitemap-sections'

const currentPath = Astro.url.pathname
const activeNavigation = getActiveNavigation(currentPath)
const headerNavigationActions = getHeaderActionLinks('navigation')
const guideIsActive = activeNavigation === 'guide'

function isLinkActive(link: HeaderNavigationLink) {
  if (link.external) return false
  const href = link.href.split('#', 1)[0]
  if (href === '/rss.xml') return currentPath === href
  return currentPath === href || currentPath.startsWith(href)
}

const panels = navigationSections.map((section) => {
  const spans = getFurtherSpans(section.groups)
  return {
    section,
    pageCount: getSectionPageCount(section),
    projects: section.projects ? ecosystemMenuProjects[section.projects] : [],
    groups: section.groups.map((group, index) => ({ ...group, span: spans[index] })),
  }
})
---

<header
  class="site-header fixed inset-x-0 top-0 z-50 border-b border-border"
  data-site-header
>
  <div class="header-shell mx-auto max-w-content px-4">
    <div class="header-row relative flex h-14 items-center justify-between gap-3">
      <a href="/" class="site-brand" aria-label="Claude Code Guide home">
        <img src="/claude-logo-orange.svg" width="23" height="23" alt="" aria-hidden="true" />
        <span class="site-brand-title"><span>Claude</span> <strong>Code Guide</strong></span>
      </a>

      <div class="mobile-menu-backdrop hidden" data-mobile-menu-close aria-hidden="true"></div>

      <div id="primary-navigation" class="primary-navigation hidden">
        <div class="mobile-drawer-header">
          <div>
            <span class="mobile-drawer-eyebrow">Navigation</span>
            <strong id="mobile-navigation-title">Explore Code Guide</strong>
          </div>
          <button type="button" class="mobile-drawer-close" aria-label="Close main navigation" data-mobile-menu-close>
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
              <path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
            </svg>
          </button>
        </div>

        <nav aria-label="Main navigation" class="primary-navigation-content">
          <a
            href={guideNavigationLink.href}
            class:list={['top-level-link top-level-direct', guideIsActive && 'is-active']}
            aria-current={guideIsActive ? 'true' : undefined}
          >
            {guideNavigationLink.label}
            <span class="mobile-only top-level-meta" aria-hidden="true">Complete guide →</span>
          </a>

          {panels.map(({ section, pageCount, projects, groups }) => {
            const isActiveSection = activeNavigation === section.id
            const allLabel = `All ${pageCount} pages in ${section.label}`
            return (
              <details
                class:list={['intent-menu', section.id === 'security' && 'intent-menu-security']}
                data-nav-section={section.id}
              >
                <summary
                  class:list={['top-level-link top-level-trigger', isActiveSection && 'is-active']}
                  data-nav-trigger={section.id}
                  aria-expanded="false"
                  aria-controls={`nav-panel-${section.id}`}
                  aria-current={isActiveSection ? 'true' : undefined}
                >
                  {section.label}
                  <svg class="nav-chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m6 8 4 4 4-4" />
                  </svg>
                </summary>

                <section
                  id={`nav-panel-${section.id}`}
                  class:list={['intent-panel', `intent-panel-${section.id}`]}
                  data-nav-panel={section.id}
                  aria-label={`${section.label} navigation`}
                >
                  <div class="intent-panel-header">
                    <strong>{section.label}</strong>
                    <span class="intent-panel-description">{section.description}</span>
                    <span class="intent-panel-links">
                      {section.overview && (
                        <a class="intent-panel-overview" href={section.overview.href}>
                          {section.overview.label} →
                        </a>
                      )}
                      <a class="intent-panel-all" href={sitemapSectionHref(section.id)}>{allLabel} →</a>
                    </span>
                  </div>

                  {section.projects && (
                    <div class="intent-panel-projects">
                      <EcosystemProjectStrip menu={section.projects} projects={projects} />
                    </div>
                  )}

                  <div class="intent-panel-body">
                    <div class="intent-block">
                      <p class="intent-kicker">Essentials</p>
                      <div class="intent-essentials">
                        {section.essentials.map((link) => {
                          const isActive = isLinkActive(link)
                          return (
                            <a
                              href={link.href}
                              class:list={['intent-link intent-card', isActive && 'is-active']}
                              aria-current={isActive ? 'page' : undefined}
                            >
                              <span class="intent-link-title">{link.label}</span>
                              <span class="intent-link-description">{link.description}</span>
                            </a>
                          )
                        })}
                      </div>
                    </div>

                    <div class="intent-block">
                      <p class="intent-kicker">Go further</p>
                      <div class="intent-further">
                        {groups.map((group) => (
                          <div class="intent-group" style={group.span > 1 ? `--span: ${group.span}` : undefined}>
                            <p class="intent-group-label">{group.label}</p>
                            <div class="intent-links">
                              {group.links.map((link) => {
                                const isActive = isLinkActive(link)
                                return (
                                  <a
                                    href={link.href}
                                    class:list={['intent-link', isActive && 'is-active']}
                                    aria-current={isActive ? 'page' : undefined}
                                    target={link.external ? '_blank' : undefined}
                                    rel={link.external ? 'noopener noreferrer' : undefined}
                                  >
                                    <span class="intent-link-title">
                                      {link.rss && (
                                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                          <path d="M6.18 15.64a2.18 2.18 0 0 1 0 4.36 2.18 2.18 0 0 1 0-4.36M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66A9.9 9.9 0 0 1 13.9 20h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" />
                                        </svg>
                                      )}
                                      {link.label}
                                      {link.external && <span aria-hidden="true">↗</span>}
                                    </span>
                                    <span class="intent-link-description">{link.description}</span>
                                  </a>
                                )
                              })}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </section>
              </details>
            )
          })}

          <a class="top-level-link top-level-direct top-level-all" href={allPagesLink.href}>
            {allPagesLink.label}
            <span class="top-level-meta" aria-hidden="true">Site map →</span>
          </a>

          {headerNavigationActions.map((link) => (
            <a
              class="header-support-action header-support-action-navigation"
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              <span>{link.label}</span>
              {link.external && <span aria-hidden="true">↗</span>}
              {link.external && <span class="sr-only">(opens in a new tab)</span>}
            </a>
          ))}

          <a class="mobile-github-link" href="https://github.com/FlorianBruniaux/claude-code-ultimate-guide" target="_blank" rel="noopener noreferrer">
            GitHub repository <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>

      <div class="header-actions flex items-center gap-1.5">
        <ThemeToggle />

        <button
          id="search-trigger"
          type="button"
          aria-label="Search (Cmd+K)"
          class="search-trigger hidden sm:flex"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.35-4.35" />
          </svg>
          <span class="search-trigger-label">Search</span>
          <kbd>⌘K</kbd>
        </button>

        <a class="all-pages-link" href={allPagesLink.href}>
          <span class="all-pages-icon" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          {allPagesLink.label}
        </a>

        <details class="github-disclosure hidden md:block">
          <summary aria-label="GitHub links">
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
            </svg>
            <svg class="github-chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m6 8 4 4 4-4" />
            </svg>
          </summary>
          <div class="github-panel">
            <a href="https://github.com/FlorianBruniaux/claude-code-ultimate-guide" target="_blank" rel="noopener noreferrer">Star repository</a>
            <a href="https://github.com/FlorianBruniaux" target="_blank" rel="noopener noreferrer">Follow Florian</a>
          </div>
        </details>

        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Open main navigation"
          aria-expanded="false"
          aria-controls="primary-navigation"
          class="mobile-menu-toggle"
        >
          <svg id="menu-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>
</header>

<script>
  import { initHeaderNavigation } from '../../scripts/header-navigation'

  initHeaderNavigation()
</script>

<style>
  .site-header {
    background: color-mix(in srgb, var(--bg-primary) 94%, transparent);
    backdrop-filter: blur(14px);
  }

  .header-shell {
    container-type: inline-size;
  }

  .site-brand {
    display: inline-flex;
    min-width: max-content;
    min-height: 44px;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-primary);
    text-decoration: none;
    transition: opacity 160ms ease;
  }

  .site-brand:hover {
    opacity: 0.78;
  }

  .site-brand-title {
    font-size: 0.875rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .site-brand-title strong {
    font-family: var(--font-mono);
    font-weight: 650;
  }

  .primary-navigation {
    position: absolute;
    z-index: 55;
    inset-block-start: calc(100% + 1px);
    inset-inline-end: -1rem;
    display: block;
    width: min(24rem, calc(100vw - 1.25rem));
    height: calc(100dvh - 3.5rem - 1px);
    padding: 0 1rem max(1rem, env(safe-area-inset-bottom));
    overflow-y: auto;
    visibility: hidden;
    border-block-start: 1px solid var(--border);
    border-inline-start: 1px solid var(--border);
    background: var(--bg-primary);
    box-shadow: -18px 0 48px rgb(0 0 0 / 0.26);
    opacity: 0;
    overscroll-behavior: contain;
    scrollbar-color: var(--border) transparent;
    transform: translateX(1.25rem);
    transition: visibility 0s linear 180ms, opacity 180ms ease, transform 180ms ease;
    pointer-events: none;
  }

  .primary-navigation.hidden {
    display: block;
  }

  .primary-navigation:not(.hidden) {
    display: block;
    visibility: visible;
    opacity: 1;
    transform: translateX(0);
    transition-delay: 0s;
    pointer-events: auto;
  }

  .primary-navigation-content {
    display: block;
  }

  .mobile-menu-backdrop {
    position: absolute;
    z-index: 54;
    inset-block-start: calc(100% + 1px);
    inset-inline-start: -1rem;
    display: block;
    width: 100vw;
    height: calc(100dvh - 3.5rem - 1px);
    visibility: visible;
    border: 0;
    background: rgb(18 16 14 / 0.56);
    opacity: 1;
    transition: visibility 0s linear 0s, opacity 180ms ease;
    pointer-events: auto;
  }

  .mobile-menu-backdrop.hidden {
    display: block;
    visibility: hidden;
    opacity: 0;
    transition-delay: 180ms, 0s;
    pointer-events: none;
  }

  .mobile-drawer-header {
    position: sticky;
    z-index: 1;
    inset-block-start: 0;
    display: flex;
    min-height: 5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: -1rem;
    padding: 0.75rem 0.75rem 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-primary);
  }

  .mobile-drawer-header strong,
  .mobile-drawer-eyebrow {
    display: block;
  }

  .mobile-drawer-header strong {
    color: var(--text-primary);
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .mobile-drawer-eyebrow {
    margin-block-end: 0.2rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .mobile-drawer-close {
    display: inline-grid;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--bg-secondary);
    color: var(--text-primary);
    cursor: pointer;
  }

  .mobile-drawer-close:hover,
  .mobile-drawer-close:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .top-level-link {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.25rem;
    border: 0;
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 650;
    text-decoration: none;
    cursor: pointer;
    transition: color 160ms ease;
  }

  .mobile-only {
    display: inline;
  }

  .intent-menu {
    border-top: 1px solid var(--border-light);
  }

  .intent-menu > summary {
    list-style: none;
  }

  .intent-menu > summary::-webkit-details-marker {
    display: none;
  }

  .top-level-link:hover,
  .top-level-link:focus-visible,
  .top-level-link.is-active,
  .top-level-link[data-open] {
    color: var(--accent);
  }

  .top-level-direct {
    border-top: 1px solid var(--border-light);
  }

  .top-level-meta {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .nav-chevron {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform 160ms ease;
  }

  .intent-menu[open] .nav-chevron {
    transform: rotate(180deg);
  }

  .header-actions {
    min-width: max-content;
  }

  a.header-support-action.header-support-action-navigation {
    align-items: center;
    justify-content: space-between;
    gap: 0.3rem;
    min-height: 44px;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }

  a.header-support-action.header-support-action-navigation:hover,
  a.header-support-action.header-support-action-navigation:focus-visible {
    color: var(--accent);
    text-decoration: none;
  }

  a.header-support-action.header-support-action-navigation > span[aria-hidden='true'] {
    font-size: 0.78em;
    opacity: 0.72;
  }

  .header-support-action-navigation {
    display: flex;
    justify-content: space-between;
    margin-block: 0.25rem;
    padding-inline: 0.75rem;
  }

  .search-trigger,
  .github-disclosure > summary,
  .mobile-menu-toggle {
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: var(--border-radius);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: color 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  /* Boxed search, as the portfolio header: visible border, label, shortcut. */
  .search-trigger {
    gap: 0.4rem;
    padding-inline: 0.65rem;
    border-color: color-mix(in srgb, var(--text-primary) 56%, var(--bg-primary));
    border-radius: var(--radius-control);
    color: var(--text-primary);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .search-trigger kbd {
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    background: var(--bg-tertiary);
    color: var(--text-muted);
    font-size: 0.7rem;
  }

  .search-trigger-label { display: none; }

  /* AM-06: no keyboard shortcut hint on touch screens. */
  @media (hover: none) {
    .search-trigger kbd { display: none; }
  }

  @media (min-width: 80rem) {
    .search-trigger-label { display: inline; }
  }

  .search-trigger:hover,
  .search-trigger:focus-visible,
  .github-disclosure > summary:hover,
  .github-disclosure > summary:focus-visible,
  .mobile-menu-toggle:hover,
  .mobile-menu-toggle:focus-visible {
    border-color: var(--border);
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }

  .github-disclosure {
    position: relative;
  }

  .github-disclosure > summary {
    display: flex;
    gap: 0.25rem;
    padding-inline: 0.65rem;
    list-style: none;
  }

  .github-disclosure > summary::-webkit-details-marker {
    display: none;
  }

  .github-chevron {
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 160ms ease;
  }

  .github-disclosure[open] .github-chevron {
    transform: rotate(180deg);
  }

  .github-panel {
    position: absolute;
    inset-block-start: calc(100% + 0.35rem);
    inset-inline-end: 0;
    display: grid;
    min-width: 11rem;
    padding: 0.35rem;
    border: 1px solid var(--border);
    border-radius: var(--border-radius-lg);
    background: var(--bg-primary);
    box-shadow: 0 18px 45px rgb(0 0 0 / 0.22);
  }

  .github-panel a {
    min-height: 40px;
    padding: 0.6rem 0.7rem;
    border-radius: 0.4rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
  }

  .github-panel a:hover,
  .github-panel a:focus-visible {
    background: var(--bg-tertiary);
    color: var(--text-primary);
  }

  .mobile-menu-toggle {
    display: inline-flex;
    padding: 0.65rem;
  }

  .intent-panel {
    display: grid;
    gap: 0.8rem;
    padding: 0 0.25rem 0.9rem;
  }

  .intent-panel-header strong {
    display: none;
  }

  .intent-panel-description {
    display: block;
    color: var(--text-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .intent-panel-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.35rem;
  }

  .intent-panel-overview,
  .intent-panel-all {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .intent-panel-overview:hover,
  .intent-panel-overview:focus-visible,
  .intent-panel-all:hover,
  .intent-panel-all:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .intent-panel-body {
    display: grid;
    gap: 0.9rem;
  }

  .intent-kicker {
    margin: 0 0 0.3rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intent-essentials,
  .intent-further,
  .intent-links {
    display: grid;
  }

  .intent-further {
    gap: 0.75rem;
  }

  .intent-group {
    min-width: 0;
  }

  .intent-group-label {
    margin: 0 0 0.25rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .intent-link {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0.65rem;
    border-radius: 0.4rem;
    color: var(--text-secondary);
    font-size: 0.84rem;
    font-weight: 550;
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
  }

  .intent-link:hover,
  .intent-link:focus-visible,
  .intent-link.is-active {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    /* Beats the global link hover underline, which would also run under the description. */
    text-decoration: none !important;
  }

  /* Current page: inset orange rule, as the portfolio menu. */
  .intent-link.is-active {
    box-shadow: inset 3px 0 0 var(--action);
  }

  /* Portfolio menu rows: the fill marks the hover, the title stays ink and gains a thin underline. */
  .intent-link:not(.intent-card):is(:hover, :focus-visible) .intent-link-title {
    color: var(--text-primary);
    text-decoration: underline;
