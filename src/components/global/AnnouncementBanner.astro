---
/**
 * AnnouncementBanner
 * Dismissible strip under the nav to surface major new content.
 * Dismissed state stored in localStorage so it stays hidden on reload.
 *
 * Update `BANNER_ID` whenever you change the message. This resets
 * the dismissed state for all visitors.
 */

// Increment this ID whenever the banner content changes
//
// NOT YET LIVE: two of the links below depend on unreleased guide content
// (written 2026-08-24, still sitting in claude-code-ultimate-guide's
// CHANGELOG under [Unreleased], not committed or pushed as of this edit).
// - /guide/workflows/cross-session-messaging/ needs the source page
//   (guide/workflows/cross-session-messaging.md) to ship through an actual
//   `/release`, then `node scripts/prepare-guide-content.mjs && pnpm build`
//   here to rebuild the guide reader.
// - /diagrams/#multi-agent needs the same release, then
//   `node scripts/build-diagrams-data.mjs` here to pick up the new 6th
//   diagram in guide/diagrams/07-multi-agent-patterns.md (theme id
//   "multi-agent" per THEME_META in that script). It opens the Multi-Agent
//   Patterns theme accordion, not the single diagram: there's no per-diagram
//   anchor in src/pages/diagrams/index.astro.
// Re-check the version badge and "Guide vX.Y.Z →" link below against the
// real released version before deploying this banner.
//
// /guide/local-vs-cloud-inference/ IS live (guide/ecosystem/local-vs-cloud-inference.md,
// synced and deployed 2026-08-25) — added 2026-08-25 in place of "Agent Harness
// Engineering" to keep the strip to 4 items.
const BANNER_ID = 'banner-local-vs-cloud-2026-08'
---

<div id="announcement-banner" class="ann-banner" data-banner-id={BANNER_ID} aria-label="Announcement">
  <div class="ann-inner">
    <div class="ann-content">
      <span class="ann-badge">v3.42.0</span>
      <span class="ann-text">
        <span style="color:var(--text-secondary)">New:</span>
        <a href="/guide/workflows/cross-session-messaging/" class="ann-link">Cross-Session Messaging</a>
        <a href="/diagrams/#multi-agent" class="ann-link" style="font-size:0.85em">(diagram)</a>
        <span class="ann-sep" aria-hidden="true">·</span>
        <a href="/guide/local-vs-cloud-inference/" class="ann-link">Local vs Cloud Inference</a>
        <span class="ann-sep" aria-hidden="true">·</span>
        <a href="/guide/context-engineering/" class="ann-link">Context Engineering + ACE-v2</a>
        <span class="ann-sep" aria-hidden="true">·</span>
        <a href="https://github.com/FlorianBruniaux/claude-code-ultimate-guide" target="_blank" rel="noopener" class="ann-link">Guide v3.42.0 →</a>
      </span>
    </div>
    <button
      id="ann-close"
      class="ann-close"
      aria-label="Dismiss announcement"
      type="button"
    >×</button>
  </div>
</div>

<script>
  const BANNER_ID = document.getElementById('announcement-banner')?.dataset.bannerId ?? ''
  const STORAGE_KEY = `ann_dismissed_${BANNER_ID}`
  const banner = document.getElementById('announcement-banner')

  // Hide immediately if already dismissed
  if (localStorage.getItem(STORAGE_KEY) === '1') {
    banner?.remove()
  }

  document.getElementById('ann-close')?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, '1')
    banner?.remove()
  })
</script>

<style>
.ann-banner {
  background: var(--bg-secondary);
  border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));
  border-top: 2px solid var(--accent);
  font-size: 0.875rem;
  line-height: 1.4;
}

.ann-inner {
  max-width: var(--max-width, 1200px);
  margin: 0 auto;
  padding: 0.5rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.ann-content {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex: 1;
  min-width: 0;
}

.ann-badge {
  flex-shrink: 0;
  display: inline-block;
  padding: 0.15rem 0.5rem;
  background: var(--accent);
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  font-family: var(--font-mono);
  letter-spacing: 0.08em;
  border-radius: 3px;
}

.ann-text {
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.ann-link {
  color: var(--accent);
  font-weight: 500;
  text-decoration: none;
  white-space: nowrap;
}

.ann-link:hover {
  text-decoration: underline;
}

.ann-sep {
  color: var(--border);
  flex-shrink: 0;
  user-select: none;
}

.ann-close {
  flex-shrink: 0;
  background: none;
  border: none;
  color: var(--text-secondary);
  font-size: 1.1rem;
  cursor: pointer;
  padding: 0.25rem 0.375rem;
  line-height: 1;
  border-radius: 3px;
  opacity: 0.6;
  transition: opacity 0.15s;
}

.ann-close:hover {
  opacity: 1;
  background: var(--bg-tertiary);
}

@media (max-width: 640px) {
  .ann-text {
    white-space: normal;
  }

  .ann-inner {
    padding: 0.5rem 1rem;
  }
}
</style>
