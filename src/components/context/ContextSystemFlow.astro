---
import { CONTEXT_SYSTEM_STAGES } from '../../data/context-page'
---

<section class="context-section" id="understand">
  <div class="context-shell">
    <div class="context-section__head">
      <p class="context-kicker">The system behind the file</p>
      <h2>Context engineering is a feedback loop</h2>
      <p>Start with one project contract, separate what changes independently, adapt it to the work, then check whether the instructions still help.</p>
    </div>
    <ol class="context-flow">
      {CONTEXT_SYSTEM_STAGES.map((stage, index) => (
        <li class="context-flow__stage">
          <div class="context-flow__number"><span>{index + 1}</span></div>
          <div class="context-flow__body">
            <span class="context-flow__icon" aria-hidden="true">{stage.icon}</span>
            <h3>{stage.title}</h3>
            <p>{stage.description}</p>
            <a href={stage.guideHref}>{stage.guideLabel} <span aria-hidden="true">→</span></a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
