---
import { BENCHMARKS, CLAIMS_VS_MEASURED } from '../../data/token-saving-benchmarks'

const benchmarkName = (id: string) => BENCHMARKS.find((b) => b.id === id)
---

<div class="claims">
  <p class="claims-explainer">
    A shell-output saving and a total-cost change are not the same quantity. The first counts tokens inside command results. The second counts everything the task billed, including file reads, reasoning and any extra agent steps the tool caused.
  </p>

  <ul class="claims-list">
    {CLAIMS_VS_MEASURED.map((row) => {
      const bench = benchmarkName(row.benchmark)
      return (
        <li class="claim-card">
          <h3 class="claim-tool">
            {row.tool}
            {!row.sameDenominator && <span class="claim-badge">Different denominator</span>}
          </h3>
          <div class="claim-pair">
            <div class="claim-side">
              <span class="claim-kicker">Vendor claim</span>
              <span class="claim-number">{row.claim}</span>
              <span class="claim-denom">of {row.claimDenominator}</span>
              <a class="claim-link" href={row.claimSource} target="_blank" rel="noopener noreferrer">Vendor source ↗</a>
            </div>
            <div class="claim-side claim-side--measured">
              <span class="claim-kicker">Measured by a third party</span>
              <span class="claim-number">{row.measured}</span>
              <span class="claim-denom">of {row.measuredDenominator}</span>
              {bench && <a class="claim-link" href={bench.url} target="_blank" rel="noopener noreferrer">{bench.publisher} ↗</a>}
            </div>
          </div>
          {!row.sameDenominator && (
            <p class="claim-why">The claim and the measurement use different denominators, so the gap is not a like-for-like contradiction. Each number answers a different question.</p>
          )}
        </li>
      )
    })}
  </ul>
</div>

<style>
.claims-explainer {
  padding: var(--space-md) var(--space-lg);
  background: color-mix(in srgb, var(--accent) 8%, var(--bg-secondary));
  border-left: 3px solid var(--accent);
  border-radius: var(--border-radius);
  color: var(--text-secondary);
  font-size: 0.9rem;
  line-height: 1.6;
  margin: 0 0 var(--space-xl);
}
.claims-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
  gap: 1.25rem;
}
.claim-card {
  padding: var(--space-lg);
  background: var(--surface-elevated);
  border: 1px solid var(--border);
  border-radius: var(--border-radius);
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  min-width: 0;
}
.claim-tool {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-primary);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
}
.claim-badge {
  font-size: 0.7rem;
  font-weight: 700;
  font-family: var(--font-mono);
  padding: 0.15rem 0.5rem;
  border-radius: 4px;
  border: 1px solid var(--bm-bad);
  color: var(--bm-bad);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.claim-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-md);
}
.claim-side {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  min-width: 0;
  padding: var(--space-sm) var(--space-md);
  background: var(--bg-tertiary);
  border-radius: 6px;
}
.claim-side--measured {
  border: 1px solid var(--border);
}
.claim-kicker {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-weight: 600;
  color: var(--text-muted);
}
.claim-number {
  font-family: var(--font-mono);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-primary);
  overflow-wrap: anywhere;
}
.claim-denom {
  font-size: 0.78rem;
  color: var(--text-secondary);
  line-height: 1.4;
}
.claim-link {
  font-size: 0.78rem;
  color: var(--accent);
  text-decoration: none;
  margin-top: auto;
  padding-top: 0.25rem;
}
.claim-link:hover { text-decoration: underline; }
.claim-why {
  font-size: 0.8rem;
  color: var(--text-secondary);
  line-height: 1.5;
  margin: 0;
}
@media (max-width: 480px) {
  .claim-pair { grid-template-columns: 1fr; }
}
</style>
