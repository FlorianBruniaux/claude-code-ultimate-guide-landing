---
import SoonBadge from './SoonBadge.astro'
import {
  getEcosystemProjectAccessibleLabel,
  isComingSoon,
  type EcosystemMenuId,
  type EcosystemMenuProject,
} from '../../data/ecosystem-discovery'
import { PERSONAL_PROJECTS } from '../../data/personal-projects.generated.ts'

interface Props {
  menu: EcosystemMenuId
  projects: EcosystemMenuProject[]
}

// Sits right under the panel title: one row of compact chips, so the projects
// stay visible without pushing Essentials and Go further below the fold.
const { menu, projects } = Astro.props
const compact = menu === 'resources'
const label = compact ? 'More projects by the author' : 'Featured projects'
---

{projects.length > 0 && (
  <section class="ecosystem-project-strip" aria-label={compact ? label : `Featured ${menu} projects`}>
    <p class="ecosystem-project-strip-label">{label}</p>
    {projects.map((project) => (
      <a
        href={project.href}
        class="ecosystem-project-strip-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={getEcosystemProjectAccessibleLabel(project)}
        title={project.format}
        data-ecosystem-project-id={project.id}
        data-ecosystem-placement="menu_strip"
        data-ecosystem-menu={menu}
      >
        <span aria-hidden="true">{project.icon}</span>
        <span class="ecosystem-project-strip-title">{project.title}</span>
        {isComingSoon(project) && <SoonBadge />}
        <span class="ecosystem-project-strip-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
    <a href="/projects/" class="ecosystem-project-strip-hub-link">
      All {PERSONAL_PROJECTS.length} projects <span aria-hidden="true">→</span>
    </a>
  </section>
)}

<style>
  .ecosystem-project-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .ecosystem-project-strip-label {
    margin: 0 0.25rem 0 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .ecosystem-project-strip-link,
  .ecosystem-project-strip-hub-link {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--border-light);
    border-radius: 999px;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .ecosystem-project-strip-arrow {
    font-size: 0.85em;
    opacity: 0.6;
  }

  .ecosystem-project-strip-hub-link {
    border-color: transparent;
    background: transparent;
    color: var(--accent);
  }

  .ecosystem-project-strip-link:hover,
  .ecosystem-project-strip-link:focus-visible {
    border-color: var(--accent);
    color: var(--text-primary);
  }

  .ecosystem-project-strip-hub-link:hover,
  .ecosystem-project-strip-hub-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (prefers-reduced-motion: reduce) {
    .ecosystem-project-strip-link {
      transition: none;
    }
  }
</style>
