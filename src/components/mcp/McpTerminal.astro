---
interface Props {
  command: string
  label?: string
}

const { command, label = 'Terminal' } = Astro.props
---

<div class="mcp-terminal" data-command-shell data-command={command}>
  <div class="terminal-head">
    <span class="terminal-label">{label}</span>
    <button type="button" class="copy-command" data-copy-command hidden>
      Copy command
    </button>
  </div>
  <div class="command-scroll" tabindex="0" aria-label={`${label} command`}>
    <span class="prompt" aria-hidden="true">$</span>
    <code>{command}</code>
  </div>
  <p class="copy-status" aria-live="polite" aria-atomic="true"></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-command-shell]').forEach((shell) => {
    const button = shell.querySelector<HTMLButtonElement>('[data-copy-command]')
    const status = shell.querySelector<HTMLElement>('.copy-status')
    const command = shell.dataset.command

    if (!button || !status || !command) return
    button.hidden = false

    button.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard API unavailable')
        await navigator.clipboard.writeText(command)
        button.textContent = 'Copied'
        status.textContent = 'Command copied.'
      } catch {
        button.textContent = 'Copy command'
        status.textContent = 'Copy failed. Select the command and copy it manually.'
      }
    })
  })
</script>

<style>
  .mcp-terminal {
    min-width: 0;
    overflow: hidden;
    background: #101318;
    border: 1px solid #303640;
    border-radius: 12px;
    box-shadow: var(--shadow-lg);
  }

  .terminal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 48px;
    padding: 0.55rem 0.75rem 0.55rem 2.75rem;
    background:
      radial-gradient(circle at 0.9rem 50%, #717985 0 4px, transparent 4.5px),
      radial-gradient(circle at 1.5rem 50%, #717985 0 4px, transparent 4.5px),
      radial-gradient(circle at 2.1rem 50%, #717985 0 4px, transparent 4.5px),
      #191d24;
    border-bottom: 1px solid #303640;
  }

  .terminal-label {
    overflow: hidden;
    color: #aab2bf;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy-command {
    flex: 0 0 auto;
    min-height: 34px;
    padding: 0.35rem 0.65rem;
    color: #e5e7eb;
    background: #252a33;
    border: 1px solid #414958;
    border-radius: 6px;
    cursor: pointer;
    font: 600 0.72rem var(--font-sans);
  }

  .copy-command:hover {
    color: #ffffff;
    border-color: #fb923c;
  }

  .copy-command:focus-visible {
    outline: 2px solid #fb923c;
    outline-offset: 2px;
  }

  .command-scroll {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    overflow-x: auto;
    padding: 1.15rem;
    scrollbar-color: #596273 #101318;
  }

  .prompt {
    flex: 0 0 auto;
    color: #fb923c;
    font: 700 0.82rem var(--font-mono);
  }

  code {
    display: block;
    flex: 0 0 auto;
    min-width: max-content;
    padding: 0;
    color: #f3f4f6;
    background: transparent;
    font-size: clamp(0.69rem, 1.6vw, 0.82rem);
    line-height: 1.6;
    white-space: nowrap;
    word-break: normal;
  }

  .copy-status {
    min-height: 1.45rem;
    margin: 0;
    padding: 0 1.15rem 0.75rem;
    color: #aab2bf;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  @media (max-width: 520px) {
    .terminal-head {
      padding-left: 0.75rem;
      background: #191d24;
    }
  }
</style>
