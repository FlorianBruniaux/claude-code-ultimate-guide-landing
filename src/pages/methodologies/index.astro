---
import Layout from '../../layouts/Layout.astro'
import MethodologyQuiz from '../../components/landing/MethodologyQuiz.astro'
import { STACK_EXPLANATIONS } from '../../data/methodology-quiz'

const title = 'AI Development Methodologies 2026 | Claude Code Guide'
const description = '20 AI-assisted development methodologies: TDD, BDD, BMAD, SDD, Eval-Driven, CDD and more. Interactive quiz, combination patterns, and decision matrix.'

const jsonLd = [
  {
    "@type": "Article",
    "headline": "AI-Assisted Development Methodologies: 20 Approaches Mapped",
    "description": "Comprehensive map of AI-assisted development methodologies with combination patterns, decision matrix, and interactive quiz to find your ideal stack.",
    "url": "https://cc.bruniaux.com/methodologies/",
    "mainEntityOfPage": "https://cc.bruniaux.com/methodologies/",
    "author": { "@type": "Person", "@id": "https://cc.bruniaux.com/#author", "name": "Florian BRUNIAUX", "url": "https://github.com/FlorianBruniaux", "jobTitle": "Founding Engineer" },
    "publisher": { "@type": "Organization", "@id": "https://cc.bruniaux.com/#organization", "name": "Claude Code Ultimate Guide", "url": "https://cc.bruniaux.com" },
    "datePublished": "2026-04-01",
    "dateModified": "2026-04-01",
    "inLanguage": "en",
    "audience": {
      "@type": "Audience",
      "audienceType": "Software developers using AI coding assistants"
    },
    "keywords": "AI development methodology, TDD, BDD, BMAD, SDD, eval-driven development, contract-driven development, plan-first, claude code methodology"
  }
]

const guideBase = 'https://cc.bruniaux.com/guide/methodologies/'

// Combination patterns table data
const COMBINATION_PATTERNS = [
  {
    stack: 'Solo MVP Builder',
    icon: '🚀',
    methodologies: 'SDD + TDD',
    bestFor: 'Solo, greenfield, quality-first',
    setup: 'Minimal',
    teamSize: '1',
    guideLink: `${guideBase}#combination-patterns`,
  },
  {
    stack: 'Team Greenfield',
    icon: '🏗️',
    methodologies: 'Spec Kit + TDD + BDD',
    bestFor: '5–10 devs, new project, shared understanding',
    setup: 'Moderate',
    teamSize: '2–10',
    guideLink: `${guideBase}#combination-patterns`,
  },
  {
    stack: 'API Contract Stack',
    icon: '🔗',
    methodologies: 'CDD + Specmatic + TDD',
    bestFor: 'Microservices, parallel teams, explicit contracts',
    setup: 'Moderate',
    teamSize: '5–20',
    guideLink: `${guideBase}#sdd-tools-reference`,
  },
  {
    stack: 'Existing Product Evolution',
    icon: '🔄',
    methodologies: 'OpenSpec + BDD + JiTTesting',
    bestFor: 'Brownfield SaaS, 100+ features, no regressions',
    setup: 'Moderate',
    teamSize: '3–15',
    guideLink: `${guideBase}#combination-patterns`,
  },
  {
    stack: 'Enterprise Governance',
    icon: '🏛️',
    methodologies: 'BMAD + Specmatic',
    bestFor: 'Traceable work with API contracts; keep one planning source',
    setup: 'Heavy',
    teamSize: 'Any',
    guideLink: `${guideBase}#combination-patterns`,
  },
  {
    stack: 'AI Product Builder',
    icon: '🤖',
    methodologies: 'Eval-Driven + Multi-Agent',
    bestFor: 'Product exposes AI to users, non-deterministic outputs',
    setup: 'Moderate',
    teamSize: '1–10',
    guideLink: `${guideBase}#the-15-methodologies`,
  },
  {
    stack: 'Power User Loop',
    icon: '⚡',
    methodologies: 'TDD + Ralph Loop + Iterative Loops',
    bestFor: 'Solo, long sessions, autonomous iteration',
    setup: 'Minimal',
    teamSize: '1',
    guideLink: `${guideBase}#the-15-methodologies`,
  },
  {
    stack: 'Structured Planner',
    icon: '📋',
    methodologies: 'Plan-First + SDD + Context Engineering',
    bestFor: 'Architecture-minded, medium codebase, mixed teams',
    setup: 'Light',
    teamSize: '1–5',
    guideLink: `${guideBase}#the-15-methodologies`,
  },
]
---

<Layout title={title} description={description} ogType="article" jsonLd={jsonLd} publishedDate="2026-04-01" modifiedDate="2026-04-01">

  <!-- Hero -->
  <header class="page-hero">
    <div class="container">
      <div class="hero-badge-row">
        <span class="hero-badge">20 methodologies mapped</span>
        <span class="hero-badge hero-badge--secondary">8 recommended stacks</span>
      </div>
      <h1>AI-assisted development methodologies</h1>
      <p class="tagline">AI-assisted development doesn't mean using Claude the same way for every project. Different team sizes, maturity levels, and contexts need different approaches.</p>
      <div class="cta-buttons">
        <a href="#methodology-quiz" class="btn btn-primary">Find My Stack →</a>
        <a href={guideBase} class="btn btn-secondary">Full Guide</a>
      </div>
    </div>
  </header>

  <!-- Methodology Quiz -->
  <MethodologyQuiz />

  <!-- Two-axis explanation -->
  <section class="section section--alt" id="methodology-map">
    <div class="container">
      <h2 class="section-title">The two-axis map</h2>
      <p class="section-subtitle">Every methodology sits somewhere on two axes. Knowing where you need to be narrows the field fast.</p>
      <div class="axis-grid">
        <div class="axis-card">
          <div class="axis-icon">📐</div>
          <h3>Spec-first vs code-first</h3>
          <p>The spec-first side makes intent explicit before implementation: SDD uses feature specs, while BDD uses shared behavior examples. BMAD spans direct building for a clear fix and deeper planning for uncertain work. These positions describe a workflow choice, not a permanent property of a tool.</p>
        </div>
        <div class="axis-card">
          <div class="axis-icon">⚖️</div>
          <h3>Lightweight vs governed</h3>
          <p>This axis compares the setup and coordination cost of development workflows. Lightweight methods can use one file and short feedback cycles; governed methods add traceability and explicit gates. It does not classify the Toyota Production System or Lean management. For flow and stop rules in AI-assisted delivery, see the <a href="/guide/loop-graph-engineering/#limit-admission-to-verification-capacity">review-admission method</a>.</p>
        </div>
      </div>

      <!-- ASCII map -->
      <div class="map-container" id="methodology-map-diagram">
        <p class="map-label">Positioning map (20 methodologies)</p>
        <pre class="methodology-map"><code>                      SPEC / PLANNING FIRST
                                ▲
  ── light · spec ──            │             ── governed · spec ──
                                │
  [Doc-Driven]  [SDD]           │    [BDD]  [ATDD]   [Req-Driven]
  [GSD]  [Plan-First]           │ [CDD] [ADR-Driven]  [DDD]  [BMAD full]
                                │
  LIGHTWEIGHT ──────────────────┼────────────────────────────────► GOVERNED
                                │
  ── light · code ──            │             ── governed · code ──
                                │
  [Context Eng.]   [TDD]        │       [Multi-Agent]
  [Prompt Eng.]  [Iterative]    │       [Eval-Driven]       [FDD]
  [Ralph Loop]                  │           [JiTTesting]
                                │
                         CODE / EMERGENT</code></pre>
        <p class="map-note">BMAD is placed here for its full planning path; a small change can use direct build. Full quadrant analysis: <a href={guideBase}>guide/methodologies/</a></p>
      </div>
    </div>
  </section>

  <section class="section lean-lens" id="lean-software-engineering" aria-labelledby="lean-lens-title">
    <div class="container">
      <p class="map-label">Lean software engineering · across every stack</p>
      <h2 class="section-title" id="lean-lens-title">Test the flow, not just the method</h2>
      <p class="section-subtitle">Mary and Tom Poppendieck's <a href="https://res.infoq.com/articles/poppendieck-implementing-lean/en/resources/poppendieck_ch02.pdf" target="_blank" rel="noopener noreferrer">software adaptation of Lean</a> asks teams to build quality in and optimize the whole path from customer need to deployed software. A better spec or a faster agent can still leave the request waiting at review, release or adoption. Lean is a delivery lens across the map above, not a twenty-first position on its axes.</p>
      <div class="table-scroll">
        <table class="matrix-table lean-table">
          <thead><tr><th scope="col">Lean question</th><th scope="col">Methods to examine</th><th scope="col">Check in the workflow</th></tr></thead>
          <tbody>
            <tr><td>Is the demand worth doing?</td><td>SDD · BDD · BMAD</td><td>Name the user problem and acceptance condition before expanding a spec. Decline or narrow work without a clear need.</td></tr>
            <tr><td>Where does work wait?</td><td>BMAD · GSD · SDD · Multi-Agent</td><td>Map one request through verification and release. Control work in progress at the constrained stage, not just inside the coding step.</td></tr>
            <tr><td>Is quality built in?</td><td>TDD · ATDD · BDD · Eval-Driven</td><td>Check behavior early and stop affected work when a test or evidence check fails. Record correction effort as well as pass rates.</td></tr>
            <tr><td>Can the plan change?</td><td>SDD · OpenSpec · BMAD</td><td>Keep reversible decisions open. Update a spec when evidence changes the requirement instead of preserving obsolete paperwork.</td></tr>
            <tr><td>Did the process improve?</td><td>Retrospectives · ADRs · verification loops</td><td>Turn a recurring failure into an upstream control, then check whether recurrence and effort fall.</td></tr>
          </tbody>
        </table>
      </div>
      <p class="lean-bridge">The <a href="https://kanbanguides.org/the-kanban-guide/" target="_blank" rel="noopener noreferrer">Kanban Guide</a> makes the flow test concrete with a defined start and finish, work-in-progress control, and four flow measures: WIP, throughput, work-item age and cycle time. Throughput counts finished items, not solved customer problems. <a href="/lean-ai/">Follow one AI-assisted request to the user</a> and <a href="/guide/team-metrics/">define the additional outcome measure</a>.</p>
      <div class="lean-source-grid" aria-label="Lean methods and inspectable repositories">
        <article class="lean-source">
          <p class="map-label">Method · product development</p>
          <h3>Value-stream mapping</h3>
          <p>The Lean Enterprise Institute maps decisions and handoffs across functions before redesigning the work.</p>
          <a href="https://www.lean.org/the-lean-post/articles/why-value-stream-mapping-is-essential-to-product-and-process-development/" target="_blank" rel="noopener noreferrer">Read the LEI method ↗</a>
        </article>
        <article class="lean-source">
          <p class="map-label">Method · knowledge work</p>
          <h3>Kanban</h3>
          <p>Define the workflow, control work in progress and inspect its four flow metrics. A board by itself does not establish pull.</p>
          <a href="https://kanbanguides.org/the-kanban-guide/" target="_blank" rel="noopener noreferrer">Read the Kanban Guide ↗</a>
        </article>
        <article class="lean-source">
          <p class="map-label">Repository · phase checks</p>
          <h3>RaiSE</h3>
          <p>Persists workflow state and runs deterministic checks at phase boundaries. The repository describes a mechanism, not a measured user outcome.</p>
          <a href="https://github.com/humansys/raise" target="_blank" rel="noopener noreferrer">Inspect RaiSE ↗</a>
        </article>
        <article class="lean-source">
          <p class="map-label">Repository · recurring defects</p>
          <h3>Andon</h3>
          <p>Records agent defects and proposed countermeasures. Its completion check still depends on the trustworthiness of the recorded evidence.</p>
          <a href="https://github.com/PrimeFoldTools/andon" target="_blank" rel="noopener noreferrer">Inspect Andon ↗</a>
        </article>
      </div>
      <h3 class="lean-packs-heading">Skill packs to test against the flow</h3>
      <p class="lean-pack-note">These packs encode steps, not a Lean result. Use only the controls that address a real constraint, then check the same request from intake to user outcome.</p>
      <div class="lean-source-grid" aria-label="Agent skill packs relevant to delivery flow">
        <article class="lean-source">
          <p class="map-label">Integrated workflow · gstack</p>
          <h4>From demand to release</h4>
          <p><code>/office-hours</code> challenges the request; <code>/landing-report</code> exposes the ship queue; <code>/qa</code> checks changed behavior and <code>/retro</code> reviews the work. The full sequence can also add waiting stages.</p>
          <a href="https://github.com/garrytan/gstack" target="_blank" rel="noopener noreferrer">Inspect gstack ↗</a>
        </article>
        <article class="lean-source">
          <p class="map-label">Composable skills · Matt Pocock</p>
          <h4>Spec only when the work needs one</h4>
          <p><code>/triage</code> handles incoming requests; <code>/to-spec</code> is for work spanning sessions; <code>/to-tickets</code> creates thin, testable vertical slices. <code>/tdd</code> and <code>/retro</code> help close the loop.</p>
          <a href="https://github.com/mattpocock/skills" target="_blank" rel="noopener noreferrer">Inspect the skills ↗</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Combination patterns table (noscript fallback + reference) -->
  <section class="section" id="methodology-decision-matrix">
    <div class="container">
      <h2 class="section-title">8 recommended stacks</h2>
      <p class="section-subtitle">These are starting combinations, not measured productivity gains. Add an artifact or gate only when it addresses a real decision, failure or handoff.</p>

      <div class="stacks-grid" id="methodology-stacks">
        {STACK_EXPLANATIONS.map((stack) => (
          <div class="stack-card" id={stack.stackId}>
            <div class="stack-card-header">
              <span class="stack-icon">{stack.icon}</span>
              <h3 class="stack-title">{stack.title}</h3>
            </div>
            <div class="stack-pills">
              {stack.methodologies.map((m) => (
                <span class="stack-pill">{m}</span>
              ))}
            </div>
            <p class="stack-description">{stack.description}</p>
            <div class="stack-quickstart">
              <p class="stack-quickstart-label">Quick start</p>
              <p class="stack-quickstart-text">{stack.quickStart}</p>
            </div>
            <a href={stack.guideLink} class="stack-link">Read in guide →</a>
          </div>
        ))}
      </div>

      <!-- Decision matrix table (noscript / reference) -->
      <div class="matrix-wrap" id="combination-patterns">
        <h3 class="matrix-title">At a glance</h3>
        <div class="table-scroll">
          <table class="matrix-table">
            <thead>
              <tr>
                <th>Stack</th>
                <th>Methodologies</th>
                <th>Best for</th>
                <th>Setup</th>
                <th>Team size</th>
              </tr>
            </thead>
            <tbody>
              {COMBINATION_PATTERNS.map((row) => (
                <tr>
                  <td>
                    <span class="table-icon">{row.icon}</span>
                    <a href={row.guideLink} class="table-link">{row.stack}</a>
                  </td>
                  <td><code>{row.methodologies}</code></td>
                  <td>{row.bestFor}</td>
                  <td><span class={`setup-badge setup-badge--${row.setup.toLowerCase()}`}>{row.setup}</span></td>
                  <td>{row.teamSize}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA to full guide -->
  <section class="section section--alt cta-section">
    <div class="container">
      <div class="cta-box">
        <h2>Want the full picture?</h2>
        <p>The guide covers all 20 methodologies in depth, with setup instructions, CLAUDE.md templates, combination patterns, and tradeoff analysis.</p>
        <div class="cta-buttons">
          <a href={guideBase} class="btn btn-primary">Read the Methodology Guide →</a>
          <a href="#methodology-quiz" class="btn btn-secondary">Retake the Quiz</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ── Page Hero ──────────────────────────────────────────────────────── */
.page-hero {
  padding: var(--space-3xl) 0 var(--space-2xl);
  text-align: left;
  background: var(--bg-primary);
  border-bottom: 1px solid var(--border);
}

.hero-badge-row {
  display: flex;
  gap: var(--space-sm);
  justify-content: flex-start;
  flex-wrap: wrap;
  margin-bottom: var(--space-lg);
}

.hero-badge {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  background: var(--bg-tertiary);
  border: 1px solid var(--border);
  border-radius: 999px;
  font-size: 0.8rem;
  font-family: var(--font-mono);
  color: var(--accent);
  font-weight: 500;
}

.hero-badge--secondary {
  color: var(--text-secondary);
}

.page-hero h1 {
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: var(--space-lg);
  max-width: 700px;
  margin-inline: 0;
}

.tagline {
  font-size: 1.1rem;
  color: var(--text-secondary);
  line-height: 1.6;
  max-width: 560px;
  margin: 0 0 var(--space-xl);
}

.cta-buttons {
  display: flex;
  gap: var(--space-md);
  justify-content: flex-start;
  flex-wrap: wrap;
}

/* ── Two-axis grid ──────────────────────────────────────────────────── */
.axis-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--space-lg);
  margin-bottom: var(--space-2xl);
}

.axis-card {
  padding: var(--space-xl);
  background: var(--surface-elevated);
  border: 1px solid var(--border);
  border-radius: var(--border-radius);
}

.axis-icon {
  font-size: 1.75rem;
  margin-bottom: var(--space-md);
}

.axis-card h3 {
  font-size: 1.05rem;
  font-weight: 700;
  margin-bottom: var(--space-sm);
  color: var(--text-primary);
}

.axis-card p {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ── ASCII map ──────────────────────────────────────────────────────── */
.map-container {
  margin-top: var(--space-xl);
}

.map-label {
  font-size: 0.8rem;
  font-family: var(--font-mono);
  color: var(--text-secondary);
  margin-bottom: var(--space-sm);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.methodology-map {
  background: var(--bg-primary);
  border: 1px solid var(--border);
  border-radius: var(--border-radius);
  padding: var(--space-xl);
  overflow-x: auto;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  line-height: 1.6;
  color: var(--text-secondary);
}

.methodology-map code {
  font-family: inherit;
  background: none;
  color: inherit;
}

.map-note {
  font-size: 0.8rem;
  color: var(--text-secondary);
  margin-top: var(--space-sm);
}

.map-note a {
  color: var(--accent);
}

/* Lean delivery lens */
.lean-lens { background: var(--bg-primary); }
.lean-lens .section-subtitle { max-width: 82ch; }
.lean-table { min-width: 760px; }
.lean-table td:first-child { width: 24%; font-weight: 700; }
.lean-table td:nth-child(2) { width: 26%; color: var(--accent); }
.lean-table td:last-child { line-height: 1.55; }
.lean-bridge { max-width: 86ch; margin: var(--space-lg) 0 var(--space-xl); color: var(--text-secondary); line-height: 1.65; }
.lean-source-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-md); }
.lean-source { display: flex; flex-direction: column; padding: var(--space-lg); border: 1px solid var(--border); border-radius: var(--border-radius); background: var(--surface-elevated); }
.lean-source h3, .lean-source h4 { margin: .4rem 0; color: var(--text-primary); font-size: 1.08rem; }
.lean-packs-heading { margin: var(--space-2xl) 0 var(--space-sm); color: var(--text-primary); font-size: 1.35rem; }
.lean-pack-note { max-width: 82ch; margin: 0 0 var(--space-lg); color: var(--text-secondary); line-height: 1.6; }
.lean-source p:not(.map-label) { margin: 0 0 .75rem; color: var(--text-secondary); font-size: .9rem; line-height: 1.55; }
.lean-source a { align-self: flex-start; margin-top: auto; font-size: .9rem; font-weight: 650; }
@media (max-width: 700px) { .lean-source-grid { grid-template-columns: 1fr; } }

/* ── Stacks grid ────────────────────────────────────────────────────── */
.stacks-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: var(--space-lg);
  margin-bottom: var(--space-2xl);
}

.stack-card {
  padding: var(--space-xl);
  background: var(--surface-elevated);
  border: 1px solid var(--border);
  border-radius: var(--border-radius);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.stack-card-header {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: 0.25rem;
}

.stack-icon {
  font-size: 1.5rem;
  line-height: 1;
}

.stack-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-primary);
}

.stack-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
}

.stack-pill {
  display: inline-block;
  padding: 0.2rem 0.6rem;
  background: var(--bg-tertiary);
  border: 1px solid var(--border);
  border-radius: 4px;
  font-size: 0.75rem;
  font-family: var(--font-mono);
  font-weight: 500;
  color: var(--accent);
}

.stack-description {
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.6;
  flex: 1;
}

.stack-quickstart {
  padding: var(--space-sm) var(--space-md);
  background: var(--bg-primary);
  border: 1px solid var(--border);
  border-radius: 6px;
}

.stack-quickstart-label {
  font-size: 0.65rem;
  font-weight: 700;
  font-family: var(--font-mono);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--accent);
  margin-bottom: 0.2rem;
}

.stack-quickstart-text {
  font-size: 0.8rem;
  color: var(--text-secondary);
  line-height: 1.5;
  font-family: var(--font-mono);
}

.stack-link {
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--accent);
  text-decoration: none;
  margin-top: auto;
}

.stack-link:hover {
  text-decoration: underline;
}

/* ── Decision matrix table ──────────────────────────────────────────── */
.matrix-wrap {
  border-top: 1px solid var(--border);
  padding-top: var(--space-xl);
}

.matrix-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-lg);
}

.table-scroll {
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: var(--border-radius);
}

.matrix-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
}

.matrix-table th {
  padding: var(--space-sm) var(--space-md);
  background: var(--bg-tertiary);
  border-bottom: 1px solid var(--border);
  text-align: left;
  font-weight: 600;
  color: var(--text-secondary);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-family: var(--font-mono);
  white-space: nowrap;
}

.matrix-table td {
  padding: var(--space-sm) var(--space-md);
  border-bottom: 1px solid var(--border);
  color: var(--text-primary);
  vertical-align: top;
}

.matrix-table tr:last-child td {
  border-bottom: none;
}

.matrix-table code {
  font-size: 0.8rem;
  color: var(--accent);
  background: var(--bg-tertiary);
  padding: 0.15rem 0.4rem;
