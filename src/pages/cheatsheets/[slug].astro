---
import Layout from '../../layouts/Layout.astro'
import PublicationEdition from '../../components/global/PublicationEdition.astro'
import { getCollection, render } from 'astro:content'
import { RECAP_BASE_URL, CARD_HASHES_FR, CARD_HASHES_EN, DIRECT_ACCESS_IDS } from '../../data/recap-cards-data'
import { resolveRecapPdfUrl } from '../../utils/resolve-recap-pdf-url'

export async function getStaticPaths() {
  const cards = await getCollection('cheatsheets')
  return cards.map(card => ({
    params: { slug: card.id },
    props: { card },
  }))
}

const { card } = Astro.props
const { Content } = await render(card)

// Build prev/next within the same series (same first char of cardNumber)
const allCards = await getCollection('cheatsheets')
const seriesChar = card.data.cardNumber[0]
const seriesCards = allCards
  .filter(c => c.data.cardNumber[0] === seriesChar)
  .sort((a, b) => a.data.order - b.data.order)
const currentIdx = seriesCards.findIndex(c => c.id === card.id)
const prevCard = currentIdx > 0 ? seriesCards[currentIdx - 1] : null
const nextCard = currentIdx < seriesCards.length - 1 ? seriesCards[currentIdx + 1] : null

const difficultyLabel: Record<string, string> = {
  beginner: 'Beginner',
  intermediate: 'Intermediate',
  advanced: 'Advanced',
}

const seriesLabel: Record<string, string> = {
  T: 'Technical',
  M: 'Methodology',
  C: 'Design',
}

const seriesId = card.data.cardNumber[0].toUpperCase() as 'T' | 'M' | 'C'
const cardHashedUrlFr = resolveRecapPdfUrl(CARD_HASHES_FR[card.id], RECAP_BASE_URL)
const cardHashedUrlEn = resolveRecapPdfUrl(CARD_HASHES_EN[card.id], RECAP_BASE_URL)
const cardHashedUrl = cardHashedUrlFr  // backward compat (used in gate script)
const isDirectAccess = DIRECT_ACCESS_IDS.has(card.id)
const API_BASE = (import.meta.env.PUBLIC_API_URL ?? 'https://www.florian.bruniaux.com/api/subscribe').replace('/api/subscribe', '')

const title = `${card.data.title} | Claude Code Recap Card ${card.data.cardNumber}`
const description = card.data.subtitle

const jsonLd = [
  {
    "@type": "TechArticle",
    "headline": card.data.title,
    "description": card.data.subtitle,
    "url": `https://cc.bruniaux.com/cheatsheets/${card.id}/`,
    "datePublished": card.data.datePublished ?? "2026-01-17",
    "dateModified": card.data.dateModified ?? "2026-06-25",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://cc.bruniaux.com/cheatsheets/${card.id}/`
    },
    "author": { "@type": "Person", "@id": "https://www.florian.bruniaux.com/#person", "name": "Florian BRUNIAUX", "url": "https://github.com/FlorianBruniaux", "jobTitle": "Fractional Chief AI Officer" },
    "publisher": { "@type": "Organization", "@id": "https://cc.bruniaux.com/#organization", "name": "Claude Code Ultimate Guide", "url": "https://cc.bruniaux.com" },
    "inLanguage": "en",
    "keywords": `claude code, ${card.data.category}, ${card.data.difficulty}, recap card, cheat sheet`,
  }
]
---

<Layout title={title} description={description} ogType="article" jsonLd={jsonLd}>

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <div class="container">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/cheatsheets/">Cheat Sheets</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page">{card.data.cardNumber}</span>
    </div>
  </nav>

  <!-- Hero -->
  <header class="page-hero card-hero">
    <div class="container">
      <div class="hero-meta">
        <span class={`card-number-badge series-${card.data.cardNumber[0].toLowerCase()}`}>
          {card.data.cardNumber}
        </span>
        <span class={`difficulty-pill diff-${card.data.difficulty}`}>
          {difficultyLabel[card.data.difficulty]}
        </span>
        <span class="category-pill">
          {card.data.category}
        </span>
      </div>
      <h1>{card.data.title}</h1>
      <p class="card-subtitle">{card.data.subtitle}</p>
      <PublicationEdition />
      <div class="hero-actions">
        {isDirectAccess ? (
          <!-- Direct access: dual FR + EN download buttons -->
          <div class="pdf-lang-group">
            <span class="pdf-lang-label">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              PDF
            </span>
            {cardHashedUrlFr && (
              <a href={cardHashedUrlFr} class="btn btn-lang btn-lang-fr" download aria-label={`Download ${card.data.title} PDF (French)`}>FR</a>
            )}
            {cardHashedUrlEn && (
              <a href={cardHashedUrlEn} class="btn btn-lang btn-lang-en" download aria-label={`Download ${card.data.title} PDF (English)`}>EN</a>
            )}
          </div>
        ) : (
          <!-- Gated: same visual as direct access, but buttons scroll to gate; JS upgrades to download links after unlock -->
          <div
            id="slug-pdf-btn"
            class="pdf-lang-group pdf-lang-group--gated"
            data-card-id={card.id}
            data-series={seriesId}
            data-hashed-url-fr={cardHashedUrlFr ?? ''}
            data-hashed-url-en={cardHashedUrlEn ?? ''}
          >
            <span class="pdf-lang-label">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              PDF
            </span>
            {cardHashedUrlFr && (
              <button type="button" class="btn btn-lang btn-lang-fr gate-lang-trigger" data-lang="fr" aria-label="Unlock French PDF">FR</button>
            )}
            {cardHashedUrlEn && (
              <button type="button" class="btn btn-lang btn-lang-en gate-lang-trigger" data-lang="en" aria-label="Unlock English PDF">EN</button>
            )}
          </div>
        )}
        <a href="/cheatsheets/" class="btn btn-secondary">
          ← All cards
        </a>
      </div>
    </div>
  </header>

  <!-- Content -->
  <main class="card-content band band-base">
    <div class="container">
      <div class="prose" id="card-prose" data-gated={!isDirectAccess ? 'true' : undefined}>
        <Content />
      </div>

      {!isDirectAccess && (
        <!-- Content gate: shown when locked, hidden after unlock -->
        <div id="content-gate" class="content-gate brand-card">
          <div class="content-gate-inner">
            <p class="content-gate-msg">Enter your email to read the full card and get the complete PDF bundle.</p>
            <p class="content-gate-note">All content is free and open-source. We just ask for your email.</p>
            <form id="content-gate-form" class="content-gate-form" novalidate>
              <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
              <input type="email" name="email" id="content-gate-email" placeholder="you@example.com" required autocomplete="email">
              <input type="url" name="linkedin" id="content-gate-linkedin" placeholder="LinkedIn profile (optional)" autocomplete="url" maxlength="200">
              <div class="gate-lang-selector">
                <span class="gate-lang-label">PDF:</span>
                <input type="radio" name="gate-lang" value="en" id="gate-lang-en" checked class="gate-lang-radio">
                <input type="radio" name="gate-lang" value="fr" id="gate-lang-fr" class="gate-lang-radio">
                <button type="button" class="gate-lang-btn gate-lang-btn-en gate-lang-btn--active" data-lang="en" aria-pressed="true">EN</button>
                <button type="button" class="gate-lang-btn gate-lang-btn-fr" data-lang="fr" aria-pressed="false">FR</button>
              </div>
              <button type="submit" id="content-gate-submit" class="btn btn-primary">
                <span class="submit-label">Unlock full card</span>
                <span class="submit-spinner hidden" aria-hidden="true"></span>
              </button>
            </form>
            <p id="content-gate-error" class="content-gate-error hidden" role="alert"></p>
            <p id="content-gate-success" class="content-gate-success hidden" role="status"></p>
          </div>
        </div>
      )}
    </div>
  </main>

  <!-- Prev/Next navigation -->
  {(prevCard || nextCard) && (
    <nav class="card-nav band band-paper section-wallpaper" aria-label="Navigate between cards in this series">
      <div class="container">
        <div class="nav-hint">
          Other cards in <strong>{seriesLabel[seriesChar] ?? card.data.category}</strong> series
        </div>
        <div class="nav-links">
          {prevCard ? (
            <a href={`/cheatsheets/${prevCard.id}/`} class="nav-prev brand-card brand-interactive-card">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div>
                <div class="nav-label">Previous</div>
                <div class="nav-title">{prevCard.data.cardNumber}: {prevCard.data.title}</div>
              </div>
            </a>
          ) : <div />}
          {nextCard && (
            <a href={`/cheatsheets/${nextCard.id}/`} class="nav-next brand-card brand-interactive-card">
              <div>
                <div class="nav-label">Next</div>
                <div class="nav-title">{nextCard.data.cardNumber}: {nextCard.data.title}</div>
              </div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </nav>
  )}

</Layout>

<script define:vars={{ seriesId, cardHashedUrl, cardHashedUrlFr, cardHashedUrlEn, API_BASE, isDirectAccess }}>
  const LS_SUBSCRIBER = 'cc-subscriber'
  const lsUnlockKey = (s) => `cc-unlocked-${s}`

  function isUnlocked() {
    try {
      return localStorage.getItem(LS_SUBSCRIBER) === '1' ||
             localStorage.getItem(lsUnlockKey(seriesId)) === '1'
    } catch { return false }
  }

  const prose = document.getElementById('card-prose')
  const contentGate = document.getElementById('content-gate')
  const pdfBtn = document.getElementById('slug-pdf-btn')

  function unlock() {
    // Remove blur/truncation from prose
    if (prose) prose.classList.remove('is-locked')
    // Hide content gate
    if (contentGate) contentGate.style.display = 'none'
    // Upgrade PDF button to direct link
    upgradePdfBtn()
  }

  function upgradePdfBtn() {
    if (!pdfBtn) return
    const urlFr = pdfBtn.dataset.hashedUrlFr || cardHashedUrlFr
    const urlEn = pdfBtn.dataset.hashedUrlEn || cardHashedUrlEn
    if (!urlFr && !urlEn) return

    // Replace gated buttons with direct download links (keep same wrapper div)
    pdfBtn.classList.remove('pdf-lang-group--gated')
    const triggers = pdfBtn.querySelectorAll('.gate-lang-trigger')
    triggers.forEach(btn => {
      const lang = btn.dataset.lang
      const url = lang === 'fr' ? urlFr : urlEn
      if (!url) { btn.remove(); return }
      const a = document.createElement('a')
      a.href = url
      a.className = btn.className.replace('gate-lang-trigger', '').trim()
      a.setAttribute('download', '')
      a.textContent = btn.textContent
      pdfBtn.replaceChild(a, btn)
    })
  }

  // Direct access cards: nothing to gate
  if (!isDirectAccess) {
    if (isUnlocked()) {
      unlock()
    } else {
      // Apply locked state: truncate + blur prose
      if (prose) prose.classList.add('is-locked')

      // FR/EN gate trigger buttons: pre-select lang, scroll to gate
      if (pdfBtn) {
        pdfBtn.querySelectorAll('.gate-lang-trigger').forEach(btn => {
          btn.addEventListener('click', () => {
            const lang = btn.dataset.lang
            // Pre-select the corresponding radio
            const radio = document.getElementById(`gate-lang-${lang}`)
            if (radio) radio.checked = true
            // Sync active state on gate-lang-btn buttons in the form
            document.querySelectorAll('.gate-lang-btn').forEach(b => {
              b.classList.toggle('gate-lang-btn--active', b.dataset.lang === lang)
              b.setAttribute('aria-pressed', b.dataset.lang === lang ? 'true' : 'false')
            })
            if (contentGate) {
              contentGate.scrollIntoView({ behavior: 'smooth', block: 'center' })
              document.getElementById('content-gate-email')?.focus()
            }
          })
        })
      }
    }
  }

  // Content gate form submission
  const gateForm = document.getElementById('content-gate-form')
  if (gateForm) {
    gateForm.addEventListener('submit', async (e) => {
      e.preventDefault()
      const email = document.getElementById('content-gate-email')?.value?.trim()
      if (!email) return

      const submitBtn = document.getElementById('content-gate-submit')
      const honeypot = gateForm.querySelector('input[name="website"]')?.value || ''
      const linkedin = document.getElementById('content-gate-linkedin')?.value?.trim() || ''

      if (submitBtn) {
        submitBtn.disabled = true
        submitBtn.querySelector('.submit-label').classList.add('hidden')
        submitBtn.querySelector('.submit-spinner').classList.remove('hidden')
      }

      const selectedLang = gateForm.querySelector('input[name="gate-lang"]:checked')?.value || 'en'
      // Stable IDs: resolved server-side by /api/guides, never break on ZIP updates
      const stableIds = {
        T: { fr: 'recap-technique.fr', en: 'recap-technique.en' },
        M: { fr: 'recap-methodologie.fr', en: 'recap-methodologie.en' },
      }
      const zipFile = stableIds[seriesId]?.[selectedLang]

      if (!zipFile) {
        showError('This series is not yet available.')
        if (submitBtn) { submitBtn.disabled = false; submitBtn.querySelector('.submit-label').classList.remove('hidden'); submitBtn.querySelector('.submit-spinner').classList.add('hidden') }
        return
      }

      try {
        const res = await fetch(`${API_BASE}/api/subscribe`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            filename: zipFile,
            website: honeypot,
            source: 'cheatsheets-slug',
            linkedin: linkedin || undefined,
          }),
        })
        const data = await res.json()

        if (submitBtn) { submitBtn.disabled = false; submitBtn.querySelector('.submit-label').classList.remove('hidden'); submitBtn.querySelector('.submit-spinner').classList.add('hidden') }

        if (data.success) {
          try {
            localStorage.setItem(lsUnlockKey(seriesId), '1')
            localStorage.setItem(LS_SUBSCRIBER, '1')
          } catch {}
          try {
            if (typeof gtag !== 'undefined') gtag('event', 'recap_card_subscribe', { event_label: seriesId })
          } catch {}
          showSuccess('Check your inbox. The PDF bundle is on its way!')
          setTimeout(() => unlock(), 2000)
        } else {
          showError(data.error || 'Failed to send. Please try again.')
        }
      } catch {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.querySelector('.submit-label').classList.remove('hidden'); submitBtn.querySelector('.submit-spinner').classList.add('hidden') }
        showError('Network error. Please try again.')
      }
    })
  }

  function showError(msg) {
    const el = document.getElementById('content-gate-error')
    const ok = document.getElementById('content-gate-success')
    if (el) { el.textContent = msg; el.classList.remove('hidden') }
    if (ok) ok.classList.add('hidden')
  }
  function showSuccess(msg) {
    const el = document.getElementById('content-gate-success')
    const err = document.getElementById('content-gate-error')
    if (el) { el.textContent = msg; el.classList.remove('hidden') }
    if (err) err.classList.add('hidden')
  }

  // Lang selector buttons
  document.querySelectorAll('.gate-lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.lang
      const radio = document.getElementById(`gate-lang-${lang}`)
      if (radio) radio.checked = true
      document.querySelectorAll('.gate-lang-btn').forEach(b => {
        b.classList.toggle('gate-lang-btn--active', b.dataset.lang === lang)
        b.setAttribute('aria-pressed', String(b.dataset.lang === lang))
      })
    })
  })
</script>

<style>
  /* ── Breadcrumb ── */
  .breadcrumb {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
  }
  .breadcrumb .container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
  }
  .breadcrumb a { color: var(--text-muted); text-decoration: none; }
  .breadcrumb a:hover, .breadcrumb a:focus-visible { color: var(--accent); text-decoration: underline; }
  .breadcrumb [aria-current="page"] { color: var(--text-secondary); }

  /* ── Container ── */
  /* Reading column, left edge on the header logo. */
  .container { max-width: 860px; margin-left: max(0px, calc((100% - var(--max-width)) / 2)); margin-right: auto; padding: 0 1rem; }

  /* ── Hero ── */
  .card-hero { padding: 3rem 0 2.5rem; }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .card-number-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-control);
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .difficulty-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-control);
    border: 1px solid currentColor;
  }
  /* Hero is always an ink band: lighter semantic tones keep the contrast. */
  .diff-beginner { color: #4ade80; }
  .diff-intermediate { color: #facc15; }
  .diff-advanced { color: #f87171; }

  .category-pill {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--border);
  }

  .card-hero h1 {
    margin: 0 0 0.5rem;
  }
  .card-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    margin: 0 0 1.5rem;
    line-height: 1.5;
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  /* Buttons inherit the shared action levels in src/styles/components.css. */

  /* FR/EN dual PDF buttons */
  .pdf-lang-group {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.5rem 0.25rem 0.75rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--border);
  }
  .pdf-lang-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .btn-lang {
    min-width: 44px;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .btn-lang:hover { background: var(--text-primary); color: var(--bg-primary); border-color: var(--text-primary); }

  /* ── Content / Prose ── */
  .card-content { padding: clamp(2.5rem, 5vw, 3.5rem) 0; }

  .prose {
    color: var(--text-secondary);
    line-height: 1.7;
    font-size: 0.95rem;
  }
  .prose :global(h2) {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent);
    margin: 2rem 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--accent);
  }
  .prose :global(h3) {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 1.5rem 0 0.5rem;
  }
  .prose :global(p) { margin: 0.75rem 0; }
  .prose :global(ul), .prose :global(ol) {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
  }
  .prose :global(li) { margin: 0.3rem 0; }
  .prose :global(strong) { color: var(--text-primary); font-weight: 700; }
  .prose :global(em) { color: var(--text-secondary); }
  .prose :global(code) {
    font-family: var(--font-mono, monospace);
    font-size: 0.85em;
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    color: var(--text-primary);
  }
  /* Override Tailwind Typography backtick pseudo-elements on inline code */
  .prose :global(:not(pre) > code::before),
  .prose :global(:not(pre) > code::after) {
    content: none !important;
  }
  .prose :global(pre) {
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1rem 0;
  }
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.85rem;
    color: var(--text-primary);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin: 1rem 0;
    overflow-x: auto;
    display: block;
  }
  .prose :global(th) {
    background: var(--bg-tertiary);
    color: var(--text-primary);
    font-weight: 700;
    text-align: left;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
  }
  .prose :global(td) {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--border);
    vertical-align: top;
  }
  .prose :global(tr:nth-child(even) td) {
    background: color-mix(in srgb, var(--bg-tertiary) 40%, transparent);
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    color: var(--text-muted);
    font-style: italic;
  }

  /* ── Prev/Next nav ── */
  .card-nav { padding: clamp(2.5rem, 5vw, 3.5rem) 0; }
  .nav-hint {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    text-align: center;
  }
  .nav-hint strong { color: var(--text-secondary); }
  .nav-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .nav-prev, .nav-next {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    text-decoration: none !important;
  }
  .nav-next { justify-content: flex-end; text-align: right; }
  .nav-prev svg, .nav-next svg { color: var(--accent); flex-shrink: 0; }
  .nav-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
