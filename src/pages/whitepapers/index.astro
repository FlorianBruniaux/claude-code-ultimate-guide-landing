  .form-success.hidden, .form-error.hidden { display: none; }
  .form-success { background: color-mix(in srgb, #22c55e 12%, transparent); color: #15803d; }
  .form-error { background: color-mix(in srgb, #ef4444 12%, transparent); color: #dc2626; }
  .form-error a { color: inherit; text-decoration: underline; }
  .submit-spinner { font-family: monospace; letter-spacing: 0.2em; }

  /* Paths */
  .paths-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .path-card {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.625rem;
    background: var(--bg-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .path-card-heading { display: flex; align-items: center; gap: 0.6rem; }
  .path-icon { font-size: 1.4rem; line-height: 1; }
  .path-label { font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin: 0; }
  .path-desc { font-size: 0.825rem; color: var(--text-secondary); margin: 0; line-height: 1.45; }
  .path-sequence {
    display: flex;
    align-items: center;
    gap: 0.25rem;
