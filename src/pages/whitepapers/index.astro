  .radio-pill:hover { color: var(--text-primary); }
  .radio-pill input { cursor: pointer; accent-color: var(--accent); }
  .submit-btn {
    width: 100%;
    padding: 0.55rem 1rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 0.4rem;
