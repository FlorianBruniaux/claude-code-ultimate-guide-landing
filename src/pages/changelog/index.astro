---
import { readFileSync, readdirSync } from 'node:fs'
import { resolve } from 'node:path'
import ReleaseEntry from '../../components/changelog/ReleaseEntry.astro'
import ChapterLabel from '../../components/global/ChapterLabel.astro'
import ConsultingCta from '../../components/global/ConsultingCta.astro'
import Layout from '../../layouts/Layout.astro'
import {
  buildGuideChangelogDisplay,
  parseGuideChangelog,
} from '../../utils/guide-changelog'

const guideRoot = process.env.GUIDE_REPO_PATH ?? resolve(process.cwd(), '../claude-code-ultimate-guide')
const changelogMarkdown = readFileSync(resolve(guideRoot, 'CHANGELOG.md'), 'utf8')
const currentVersion = readFileSync(resolve(guideRoot, 'VERSION'), 'utf8').trim()

function collectGuideMarkdownPaths(root: string): ReadonlySet<string> {
  const paths = new Set<string>()

  function visit(directory: string, relativeDirectory: string): void {
    for (const entry of readdirSync(directory, { withFileTypes: true })) {
      const relativePath = `${relativeDirectory}/${entry.name}`
      if (entry.isDirectory()) visit(resolve(directory, entry.name), relativePath)
      else if (entry.isFile() && entry.name.endsWith('.md')) paths.add(relativePath)
    }
  }

  visit(resolve(root, 'guide'), 'guide')
  return paths
}

const publishedGuidePaths = collectGuideMarkdownPaths(guideRoot)
const releases = parseGuideChangelog(changelogMarkdown)
const displayedReleases = buildGuideChangelogDisplay(releases, currentVersion)
const recentReleases = displayedReleases.slice(0, 12)
const olderReleases = displayedReleases.slice(12)

function formatDate(date: string | null): string {
  if (!date) return 'Date not recorded'
  return new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`))
}

const title = 'Guide Changelog | Claude Code Ultimate Guide'
const description = 'Every documented update to the Claude Code Ultimate Guide, including new pages, corrected references, tools, ebooks, recap cards, and machine-readable resources.'
---

<Layout title={title} description={description} noIndex={false}>
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Guide v{currentVersion}</p>
      <h1>Guide changelog</h1>
      <p class="tagline">New pages, corrections, resources, and tooling, listed from newest to oldest.</p>
      <p class="route-note">Looking for changes to the Claude Code CLI? See <a href="/releases/">Claude Code Releases</a>.</p>
    </div>
  </header>

  <nav class="version-nav band band-paper section-wallpaper" aria-label="Jump to a version">
    <div class="container">
      <p class="nav-label">Jump to</p>
      <ul class="version-chips">
        {recentReleases.map((release) => (
          <li><a href={`#${release.anchor}`}>{release.version === 'Unreleased' ? 'Unreleased' : `v${release.version}`}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <div class="changelog-page band band-ink section-wallpaper">
    <div class="container">
      <ChapterLabel number="01" label="History" />
      <div class="history-heading">
        <h2>Release history</h2>
        <p>{displayedReleases.length} documented guide releases.</p>
      </div>
      {recentReleases.slice(0, 1).map((release) => (
        <ReleaseEntry release={release} publishedGuidePaths={publishedGuidePaths} latest />
      ))}
    </div>
  </div>

  <div class="changelog-page band band-base">
    <div class="container">
      {recentReleases.slice(1).map((release) => (
        <ReleaseEntry release={release} publishedGuidePaths={publishedGuidePaths} />
      ))}
    </div>
  </div>

  <div class="changelog-page band band-paper section-wallpaper">
    <div class="container">
      {olderReleases.length > 0 && (
        <details class="older-releases">
          <summary>Show {olderReleases.length} older releases</summary>
          {olderReleases.map((release) => (
            <ReleaseEntry release={release} publishedGuidePaths={publishedGuidePaths} compact />
          ))}
        </details>
      )}

      <ConsultingCta placement="guide-changelog" />
    </div>
  </div>
</Layout>

<style>
  .container { max-width: var(--max-width); margin: 0 auto; padding: 0 1rem; }
  .page-hero { padding: 3rem 0 2.25rem; }
  .eyebrow { margin: 0 0 0.45rem; color: var(--accent); font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .page-hero h1 { margin: 0; }
  .tagline { max-width: 680px; margin: 0.8rem 0 0; color: var(--text-secondary); font-size: 1.05rem; line-height: 1.6; }
  .route-note { margin: 1rem 0 0; color: var(--text-secondary); font-size: 0.9rem; }
  .route-note a { color: var(--accent); font-weight: 650; text-decoration: underline; text-underline-offset: 0.18em; }
  .route-note a:hover { text-decoration-thickness: 2px; }
  .route-note a:focus-visible, .older-releases > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .version-nav { padding: 1.25rem 0; }
  .version-nav .container { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; }
  .nav-label { margin: 0; color: var(--text-muted); font-family: var(--font-mono); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .version-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .version-chips a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.85rem; border: 1px solid var(--border); border-radius: var(--radius-control); color: var(--text-primary); font-family: var(--font-mono); font-size: 0.85rem; font-weight: 650; text-decoration: none; transition: background-color 150ms ease, color 150ms ease; }
  .version-chips a:hover { background: var(--text-primary); border-color: var(--text-primary); color: var(--bg-primary); }
  .version-chips a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .changelog-page { padding: 2.75rem 0 3rem; }
  .history-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin: 0 0 1.5rem; }
  .history-heading h2 { margin: 0; color: var(--text-primary); font-size: 1.6rem; }
  .history-heading p { margin: 0; color: var(--text-muted); }
  .older-releases { margin-top: 0.5rem; }
  .older-releases > summary { cursor: pointer; margin-bottom: 1.25rem; padding: 0.9rem 0; min-height: 44px; color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 0.18em; }
  @media (max-width: 640px) {
    .page-hero { padding-top: 2.25rem; }
    .history-heading { align-items: flex-start; flex-direction: column; }
  }
</style>
