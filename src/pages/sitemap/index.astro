---
import Layout from '../../layouts/Layout.astro'
import { getCollection } from 'astro:content'
import {
  countSitemapPages,
  getGuideSitemapSections,
  getMenuSitemapSections,
  guidePortalLink,
  type SitemapLink,
} from '../../data/sitemap-sections.ts'

const cheatsheetCards = await getCollection('cheatsheets').catch(() => [])
const sortedCards = cheatsheetCards.sort((a, b) => a.data.order - b.data.order)
const cardSeries = [
  { id: 'cheat-sheets-technical', label: 'Technical series', category: 'Technical' },
  { id: 'cheat-sheets-methodology', label: 'Methodology series', category: 'Methodology' },
  { id: 'cheat-sheets-design', label: 'Design series', category: 'Design' },
].map((series) => ({
  ...series,
  links: sortedCards
    .filter((card) => card.data.category === series.category)
    .map((card): SitemapLink => ({
      href: `/cheatsheets/${card.id}/`,
      label: `${card.data.cardNumber}: ${card.data.title}`,
      description: card.data.subtitle,
    })),
}))

// Menu sections first (Start, Build, Scale, Security, Resources), then the
// guide chapters, then the card collections, folded by default.
const menuSections = getMenuSitemapSections()
const guideSections = getGuideSitemapSections()
const cardLinks = cardSeries.flatMap((series) => series.links)
const pageCount = countSitemapPages([...menuSections, ...guideSections], [guidePortalLink, ...cardLinks])

const jumpLinks = [
  ...menuSections.map((section) => ({ href: `#${section.id}`, label: section.label })),
  { href: '#guide-chapters', label: 'Guide chapters' },
  { href: '#cheat-sheets', label: 'Cheat sheets' },
]

function haystack(link: SitemapLink) {
  return `${link.label} ${link.description ?? ''} ${link.href}`.toLowerCase()
}
---

<Layout
  title="All pages | Claude Code Ultimate Guide"
  description="Every key page of the Claude Code Ultimate Guide, organised like the site menu, with the guide chapters, cheat sheets and a link to the complete XML sitemap."
  noIndex={false}
>
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Sitemap</p>
      <h1>All pages</h1>
      <p class="tagline">
        {pageCount} pages on <strong>cc.bruniaux.com</strong>, organised like the menu.
        Use <kbd>⌘K</kbd> for full-text search, or the <a href="/sitemap-index.xml">complete XML sitemap</a> for every indexable URL.
      </p>
      <label class="filter" for="sitemap-filter">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle cx="9" cy="9" r="5.5" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="m13.5 13.5 3.5 3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8" />
        </svg>
        <span class="sr-only">Filter pages</span>
        <input id="sitemap-filter" type="search" placeholder="Filter pages by title or topic…" autocomplete="off" />
        <span class="filter-count" aria-live="polite" data-filter-count></span>
      </label>
    </div>
  </header>

  <nav class="jump-nav" aria-label="Sitemap sections">
    <div class="container jump-nav-inner">
      {jumpLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </nav>

  <main class="sitemap-content" data-sitemap>
    <div class="container">
      {menuSections.map((section) => (
        <section class="sitemap-section" id={section.id} data-filter-section>
          <h2 class="section-title">
            <a class="section-anchor" href={`#${section.id}`}>{section.label}</a>
            <span class="section-count">{section.essentials.length + section.links.length + (section.overview ? 1 : 0)}</span>
          </h2>
          {section.description && <p class="section-desc">{section.description}</p>}
          <ul class="essential-grid">
            {section.overview && (
              <li data-filter-item data-filter-text={`${section.overview.label} ${section.overview.href}`.toLowerCase()}>
                <a href={section.overview.href} class="essential-link is-overview brand-card brand-interactive-card">
                  <span class="link-label">{section.overview.label} →</span>
                </a>
              </li>
            )}
            {section.essentials.map((link) => (
              <li data-filter-item data-filter-text={haystack(link)}>
                <a href={link.href} class="essential-link brand-card brand-interactive-card">
                  <span class="link-label">{link.label}</span>
                  {link.description && <span class="link-desc">{link.description}</span>}
                </a>
              </li>
            ))}
          </ul>
          {section.links.length > 0 && (
            <ul class="compact-grid">
              {section.links.map((link) => (
                <li data-filter-item data-filter-text={haystack(link)}>
                  <a href={link.href} class="compact-link" title={link.description} {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}

    </div>
    <div class="band band-ink section-wallpaper sitemap-ink">
    <div class="container">
      <section class="sitemap-part" id="guide-chapters" data-filter-section>
        <h2 class="part-title">
          <a class="section-anchor" href="#guide-chapters">Guide chapters</a>
          <a class="part-link" href={guidePortalLink.href}>Open the guide portal →</a>
        </h2>
        <div class="guide-columns">
          {guideSections.map((section) => (
            <section class="guide-group" id={section.id} data-filter-section>
              <h3>
                <a class="section-anchor" href={`#${section.id}`}>{section.label}</a>
                <span class="section-count">{section.links.length}</span>
              </h3>
              <ul>
                {section.links.map((link) => (
                  <li data-filter-item data-filter-text={haystack(link)}>
                    <a href={link.href} class="compact-link" title={link.description}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>
    </div>
    </div>
    <div class="container">
      <section class="sitemap-part sitemap-cheats" id="cheat-sheets" data-filter-section>
        <h2 class="part-title">
          <a class="section-anchor" href="#cheat-sheets">Cheat sheets</a>
          <a class="part-link" href="/cheatsheets/">All {cardLinks.length} cards →</a>
        </h2>
        {cardSeries.map((series) => (
          <details class="card-series" id={series.id} data-filter-section>
            <summary>
              <span>{series.label}</span>
              <span class="section-count">{series.links.length}</span>
            </summary>
            <ul class="compact-grid">
              {series.links.map((link) => (
                <li data-filter-item data-filter-text={haystack(link)}>
                  <a href={link.href} class="compact-link" title={link.description}>{link.label}</a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </section>

      <p class="filter-empty" data-filter-empty hidden>
        No page matches this filter. Try <kbd>⌘K</kbd> to search inside the pages.
      </p>
    </div>
  </main>
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>('#sitemap-filter')
  const root = document.querySelector<HTMLElement>('[data-sitemap]')
  const count = document.querySelector<HTMLElement>('[data-filter-count]')
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]')

  if (input && root) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-filter-item]'))
    // Inner groups first, so a part hides only when all its groups are empty.
    const sections = Array.from(root.querySelectorAll<HTMLElement>('[data-filter-section]')).reverse()
    const details = Array.from(root.querySelectorAll<HTMLDetailsElement>('details.card-series'))
    const initiallyOpen = new Map(details.map((element) => [element, element.open]))

    const apply = () => {
      const terms = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean)
      let visible = 0
      for (const item of items) {
        const text = item.dataset.filterText ?? ''
        const match = terms.every((term) => text.includes(term))
        item.hidden = !match
        if (match) visible++
      }
      for (const section of sections) {
        section.hidden = terms.length > 0 && !section.querySelector('[data-filter-item]:not([hidden])')
      }
      for (const element of details) {
        element.open = terms.length > 0 ? !element.hidden : initiallyOpen.get(element) ?? false
      }
      if (count) count.textContent = terms.length > 0 ? `${visible} match${visible === 1 ? '' : 'es'}` : ''
      if (empty) empty.hidden = terms.length === 0 || visible > 0
    }

    input.addEventListener('input', apply)
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && input.value) {
        input.value = ''
        apply()
      }
    })

    // A deep link to a folded series opens it.
    const openFromHash = () => {
      const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null
      if (target instanceof HTMLDetailsElement) target.open = true
    }
    window.addEventListener('hashchange', openFromHash)
    openFromHash()
  }
</script>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }

  .page-hero {
    padding: 3rem 0 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  .eyebrow {
    margin: 0 0 0.35rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .page-hero h1 {
    margin: 0 0 0.5rem;
    color: var(--text-primary);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
  }
  .tagline {
    max-width: 48rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }
  .tagline strong { color: var(--text-primary); }
  kbd {
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    background: var(--bg-secondary);
    font-family: inherit;
    font-size: 0.8em;
  }

  .filter {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    max-width: 36rem;
    margin-top: 1.5rem;
    padding: 0.7rem 1rem;
    border: 2px solid var(--accent);
    border-radius: var(--radius-control);
    background: var(--bg-primary);
    color: var(--accent);
  }
  .filter input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--text-primary);
    font-size: 1rem;
  }
  .filter-count {
    color: var(--text-muted);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .jump-nav {
    position: sticky;
    top: calc(3.5rem + 1px);
    z-index: 5;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    backdrop-filter: blur(8px);
  }
  .jump-nav-inner {
    display: flex;
    gap: 0.4rem;
    padding-block: 0.6rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .jump-nav a {
    display: inline-flex;
    align-items: center;
    flex: none;
    min-height: 44px;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
  }
  /* Filter controls of the portfolio: link-coloured border and 12 % tint on hover. */
  .jump-nav a:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--surface-elevated) 88%, var(--accent));
    color: var(--text-primary);
  }

  .sitemap-content { padding: 2.5rem 0 5rem; }

  .sitemap-section,
  .sitemap-part,
  .guide-group,
  .card-series {
    scroll-margin-top: 8rem;
  }
  [hidden] { display: none !important; }

  .sitemap-section {
    margin-bottom: 2.75rem;
  }
  .sitemap-ink { padding: 3rem 0; margin: 1rem 0 3rem; }
  .sitemap-cheats { margin-top: 0; }

  .section-title,
  .part-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    position: relative;
    margin: 0 0 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--text-primary);
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    font-weight: 700;
  }

  /* Short orange bar on the hairline, as the portfolio reading h2. */
  .section-title::before,
  .part-title::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 2.5rem;
    height: 3px;
    background: var(--action);
  }
  .section-anchor {
    color: inherit;
    text-decoration: none;
  }
  .section-anchor:hover { color: var(--accent); }
  .section-anchor:hover::after {
    content: ' #';
    color: var(--text-muted);
  }
  .section-desc {
    margin: 0 0 1rem;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  .section-count {
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-control);
    background: var(--bg-tertiary);
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .part-link {
    margin-left: auto;
    font-size: 0.85rem;
    font-weight: 600;
  }

  ul { list-style: none; margin: 0; padding: 0; }

  .essential-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }
  .essential-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: var(--border-radius-lg);
    background: var(--surface-elevated);
    text-decoration: none;
  }
  .essential-link.is-overview {
    justify-content: center;
    border-style: dashed;
  }
  .link-label {
    color: var(--text-primary);
    font-size: 0.92rem;
    font-weight: 700;
  }
  .link-desc {
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .compact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.15rem 1.25rem;
  }
  .compact-link {
    display: block;
    padding: 0.35rem 0.5rem;
    border-radius: 0.35rem;
    color: var(--text-secondary);
    font-size: 0.86rem;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    text-underline-offset: 0.22em;
  }
  .compact-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .compact-link:hover {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    color: var(--accent);
  }

  .sitemap-part {
    margin-top: 3.25rem;
  }
  .guide-columns {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.75rem 1.5rem;
    margin-top: 1.25rem;
  }
  .guide-group h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    color: var(--text-primary);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card-series {
    margin-top: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
  }
  .card-series summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    color: var(--text-primary);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .card-series summary::-webkit-details-marker { display: none; }
  .card-series summary::before {
    content: '▸';
    color: var(--accent);
    transition: transform 150ms ease;
  }
  .card-series[open] summary::before { transform: rotate(90deg); }
  .card-series .compact-grid { padding: 0 0.75rem 0.9rem; }

  .filter-empty {
    margin-top: 2rem;
    color: var(--text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .essential-grid,
    .compact-grid { grid-template-columns: 1fr; }
  }
</style>
