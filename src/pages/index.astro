---
import Layout from '../layouts/Layout.astro'
import HeroBanner from '../components/landing/HeroBanner.astro'
import StartHere from '../components/landing/StartHere.astro'
import FlagshipResources from '../components/landing/FlagshipResources.astro'
import McpProof from '../components/landing/McpProof.astro'
import ExploreDeeper from '../components/landing/ExploreDeeper.astro'
import LatestContent from '../components/landing/LatestContent.astro'
import Community from '../components/landing/Community.astro'
import RelatedProjects from '../components/landing/RelatedProjects.astro'
import ConsultingCta from '../components/global/ConsultingCta.astro'
import { getSiteStats } from '../utils/site-stats'
import { authorProfile } from '../data/author-profile'

const stats = await getSiteStats()

const title = 'Claude Code Guide: Templates, Security, Workflows | Free'
const description = `Master Claude Code with 25K+ lines of documentation, ${stats.templateCount} templates, 473-question quiz, ${stats.cveCount} CVEs tracked, and TDD/SDD/BDD workflows. Free & open-source.`

const jsonLd = [
  {
    "@type": "Course",
    "name": "Claude Code Ultimate Guide",
    "description": `Free, open-source guide for Claude Code (Anthropic CLI): 25K+ lines of documentation, ${stats.templateCount} templates, 473-question quiz, security threat database (${stats.cveCount} CVEs), and methodology workflows.`,
    "url": "https://cc.bruniaux.com/",
    "provider": {
      "@type": "Organization",
      "@id": "https://cc.bruniaux.com/#organization",
      "name": "Claude Code Ultimate Guide",
      "url": "https://cc.bruniaux.com",
    },
    "author": {
      "@type": "Person",
      "@id": "https://cc.bruniaux.com/#author",
      "name": authorProfile.name,
      "url": authorProfile.aboutUrl,
      "image": `https://cc.bruniaux.com${authorProfile.imageUrl}`,
      "jobTitle": authorProfile.role,
      "sameAs": [authorProfile.githubUrl, authorProfile.linkedinUrl],
    },
    "isAccessibleForFree": true,
    "educationalLevel": "Beginner to Advanced",
    "inLanguage": "en",
    "datePublished": "2025-06-01",
    "dateModified": "2026-08-31",
    "teaches": [
      "Claude Code CLI installation and configuration",
      "CLAUDE.md project memory files",
      "MCP server integration and security vetting",
      "Custom agents, skills, and slash commands",
      "Event hooks for automation",
      "TDD, SDD, BDD methodologies with AI",
      "Context window management",
      "Production security hardening"
    ],
    "numberOfCredits": 0,
    "hasCourseInstance": {
      "@type": "CourseInstance",
      "courseMode": "online",
      "courseWorkload": "PT10H",
    },
  },
  {
    "@type": "SoftwareApplication",
    "name": "Claude Code",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "macOS, Linux, Windows",
    "url": "https://docs.anthropic.com/en/docs/claude-code/overview",
    "description": "Anthropic's official CLI for AI-assisted development. Reads your codebase, writes code, runs commands, and makes multi-file changes autonomously from the terminal.",
    "author": {
      "@type": "Organization",
      "name": "Anthropic",
      "url": "https://anthropic.com",
    },
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD",
      "description": "Free to install (API usage billed separately)",
    },
    "featureList": [
      "Full filesystem access for multi-file edits",
      "MCP server integration",
      "Custom agents, skills, and slash commands",
      "Event hooks for automation",
      "Plan Mode for complex task orchestration",
      "CLAUDE.md project memory",
    ],
  },
]
---

<Layout title={title} description={description} jsonLd={jsonLd} preloadImages={['/claude-logo-orange.svg']} compactFooter>
  <HeroBanner />
  <StartHere />
  <FlagshipResources />
  <McpProof />
  <ExploreDeeper />
  <LatestContent />
  <Community />
  <RelatedProjects />
  <ConsultingCta placement="homepage" />
</Layout>
