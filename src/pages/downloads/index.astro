---
import Layout from '../../layouts/Layout.astro'
import ChapterLabel from '../../components/global/ChapterLabel.astro'
import PublicationEdition from '../../components/global/PublicationEdition.astro'
import { GUIDE_DOWNLOADS } from '../../data/homepage-content'

const title = 'Download Claude Code Ultimate Guide | PDF & EPUB'
const description = 'Download the complete Claude Code Ultimate Guide in English or French, as PDF or EPUB.'
const languages = [...new Set(GUIDE_DOWNLOADS.map((download) => download.language))]
---

<Layout title={title} description={description}>
  <header class="page-hero">
    <div class="container download-hero">
      <a class="back-link" href="/">← Home</a>
      <p class="eyebrow">Offline guide</p>
      <h1>Download the complete guide</h1>
      <p class="tagline">English and French editions, ready for offline reading in PDF or EPUB.</p>
      <PublicationEdition formats="PDF and EPUB editions" />
    </div>
  </header>

  <main class="band band-base section-wallpaper download-band">
    <div class="container download-layout">
      <ChapterLabel number="01" label="Editions" />
      {languages.map((language) => (
        <section class="language-card brand-card" aria-labelledby={`language-${language.toLowerCase()}`}>
          <div>
            <span class="language-code">{language}</span>
            <h2 id={`language-${language.toLowerCase()}`}>{language === 'FR' ? 'Édition française' : 'English edition'}</h2>
            <p>{language === 'FR' ? 'Guide complet, à lire et à annoter hors ligne.' : 'Full guide, ready for offline reading and annotation.'}</p>
          </div>
          <div class="download-actions">
            {GUIDE_DOWNLOADS.filter((download) => download.language === language).map((download) => (
              <a class={`btn ${download.format === 'PDF' ? 'btn-primary' : 'btn-secondary'}`} href={download.href} target="_blank" rel="noopener">
                {language === 'FR' ? 'Télécharger' : 'Download'} {download.format}
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
  <section class="band band-paper section-wallpaper download-band" aria-labelledby="after-download-title">
    <div class="container download-layout">
      <h2 id="after-download-title" lang="fr">Après le téléchargement</h2>
      <div class="next-paths">
        <article class="next-path brand-card">
          <div lang="fr">
            <h3>Apprendre en autonomie</h3>
            <p>Choisissez un parcours selon votre niveau, puis pratiquez avec le guide et les exercices.</p>
            <a class="btn btn-secondary" href="/learning/">Choisir mon parcours (en anglais) →</a>
          </div>
          <p class="path-english" lang="en">Learning on your own? <a href="/learning/">Choose a learning path for your level</a>.</p>
        </article>
        <article class="next-path brand-card">
          <div lang="fr">
            <h3>Former une équipe</h3>
            <p>Travaillez sur les pratiques Claude Code et Codex avec un programme de formation pour votre équipe.</p>
            <a class="btn btn-secondary" href="https://www.florian.bruniaux.com/fr/prestations/formation/?utm_source=cc-guide&amp;utm_medium=cta&amp;utm_campaign=consulting&amp;utm_content=downloads">Voir le programme de formation →</a>
          </div>
          <p class="path-english" lang="en">Training your team? <a href="https://www.florian.bruniaux.com/services/training/?utm_source=cc-guide&amp;utm_medium=cta&amp;utm_campaign=consulting&amp;utm_content=downloads">Explore Claude Code and Codex team training</a>.</p>
        </article>
      </div>
    </div>
  </section>
  <section class="band band-ink section-wallpaper release-band">
    <div class="container download-layout">
      <aside class="release-note">
        <strong>Need a specific version?</strong>
        <span>Browse every published artifact and release note on GitHub.</span>
        <a class="btn btn-quiet" href="https://github.com/FlorianBruniaux/claude-code-ultimate-guide/releases" target="_blank" rel="noopener">View all releases →</a>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .download-hero, .download-layout { max-width: 900px; margin-left: max(0px, calc((100% - var(--max-width)) / 2)); margin-right: auto; }
  .back-link { display: inline-flex; align-items: center; min-height: 44px; font-weight: 650; }
  .eyebrow { margin: 1rem 0 0.4rem; color: var(--accent); font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .download-band { padding: clamp(3rem, 6vw, 4.5rem) 0; }
  .download-layout { display: grid; gap: 1rem; }
  .language-card { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: clamp(1.4rem, 4vw, 2rem); }
  .language-code { color: var(--accent); font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700; }
  .language-card h2 { margin: 0.25rem 0 0; font-size: 1.35rem; }
  .language-card p { margin: 0.3rem 0 0; color: var(--text-secondary); }
  .download-actions { display: flex; gap: 0.65rem; flex: 0 0 auto; }
  .download-layout > h2 { margin: 0; font-size: clamp(1.75rem, 4vw, 2.25rem); }
  .next-paths { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .next-path { padding: clamp(1.4rem, 4vw, 2rem); }
  .next-path h3 { margin: 0; font-size: 1.35rem; }
  .next-path p { color: var(--text-secondary); }
  .next-path .btn { margin-top: 0.5rem; }
  .path-english { margin: 1.5rem 0 0; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.9rem; }
  .release-band { padding: clamp(2rem, 5vw, 3rem) 0; }
  .release-note { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem; padding: 0; color: var(--text-secondary); font-size: 0.95rem; }
  .release-note strong { color: var(--text-primary); }
  @media (max-width: 680px) {
    .next-paths { grid-template-columns: 1fr; }
    .language-card { align-items: flex-start; flex-direction: column; }
    .download-actions { width: 100%; }
    .download-actions .btn { flex: 1; }
    .release-note { grid-template-columns: 1fr; gap: 0.25rem; }
  }
</style>
