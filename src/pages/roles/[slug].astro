---
import Layout from '../../layouts/Layout.astro'
import { ROLES, ROLES_META, STATUS_CONFIG } from '../../data/ai-roles'

export function getStaticPaths() {
  const slugify = (str: string) =>
    str.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
  return ROLES.map(role => ({
    params: { slug: slugify(role.title) },
    props: { role },
  }))
}

function slugify(str: string): string {
  return str.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
}

const { role } = Astro.props
const statusConf = STATUS_CONFIG[role.evidence]

const pageUrl = `https://cc.bruniaux.com/roles/${slugify(role.title)}/`
const top5Skills = role.skills.slice(0, 5).join(', ')
const compensationAnswer = 'Compare live postings with the same country, location or remote policy, level, employer type, and compensation components. A single disclosed range is not a market benchmark.'

const title = `${role.title}: Skills & Career Path 2026 | Claude Code Guide`
const metaDesc = `${role.title} profile: ${role.mission.slice(0, 130)}. Evidence classification, required skills, and entry paths.`

const jsonLd = [
  {
    "@type": "Article",
    "headline": `${role.title}: Skills & Career Path 2026`,
    "description": role.mission,
    "url": pageUrl,
    "mainEntityOfPage": pageUrl,
    "author": { "@type": "Person", "@id": "https://cc.bruniaux.com/#author", "name": "Florian BRUNIAUX", "url": "https://github.com/FlorianBruniaux", "jobTitle": "Founding Engineer" },
    "publisher": { "@type": "Organization", "@id": "https://cc.bruniaux.com/#organization", "name": "Claude Code Ultimate Guide", "url": "https://cc.bruniaux.com" },
    "datePublished": "2026-03-09",
    "dateModified": ROLES_META.modifiedDate,
    "inLanguage": "en",
  },
  {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": `What does a ${role.title} do?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": role.mission.slice(0, 200),
        },
      },
      {
        "@type": "Question",
        "name": `What skills does a ${role.title} need?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `The core skills for a ${role.title} are: ${top5Skills}.`,
        },
      },
      {
        "@type": "Question",
        "name": `How should I evaluate compensation for a ${role.title}?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": compensationAnswer,
        },
      },
    ],
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://cc.bruniaux.com/" },
      { "@type": "ListItem", "position": 2, "name": "AI Roles", "item": "https://cc.bruniaux.com/roles/" },
      { "@type": "ListItem", "position": 3, "name": role.title, "item": pageUrl },
    ],
  },
]
---

<Layout title={title} description={metaDesc} ogType="article" jsonLd={jsonLd} publishedDate="2026-03-09" modifiedDate={ROLES_META.modifiedDate}>

  <header class="page-hero page-hero--compact">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">›</span>
        <a href="/roles/">AI Roles</a>
        <span class="breadcrumb-sep">›</span>
        <span>{role.title}</span>
      </nav>

      <div class="role-hero-header">
        <h1>{role.title}</h1>
        <span class="role-status-badge" style={`--status-color: ${statusConf.color}`}>
          {statusConf.label}
        </span>
      </div>

      <p class="tagline">{role.mission}</p>
    </div>
  </header>

  <div class="container role-body">

    <!-- Entry paths -->
    <section class="role-section">
      <h2>Who moves into this role</h2>
      <ul class="entry-paths-list">
        {role.entryPaths.map(path => (
          <li>{path}</li>
        ))}
      </ul>
    </section>

    <!-- Skills -->
    <section class="role-section">
      <h2>Required skills</h2>
      <div class="skills-grid">
        {role.skills.map(skill => (
          <div class="skill-item">
            <span class="skill-bullet">→</span>
            <span>{skill}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Evidence classification -->
    <section class="role-section">
      <h2>Evidence classification</h2>
      <p><strong>{role.evidence}.</strong> This label describes the evidence reviewed in August 2026. It does not guarantee that every employer uses the same title or ownership boundary.</p>
      <p><a href={`${ROLES_META.sourceUrl}#${role.guideAnchor}`}>Read the sourced profile and evidence boundary →</a></p>
    </section>

    <!-- FAQ -->
    <section class="role-section role-faq">
      <h2>Frequently asked questions</h2>

      <div class="faq-item">
        <h3>What does a {role.title} do?</h3>
        <p>{role.mission}</p>
      </div>

      <div class="faq-item">
        <h3>What skills does a {role.title} need?</h3>
        <p>The core skills are: {top5Skills}.</p>
      </div>

      <div class="faq-item">
        <h3>How should I evaluate compensation for a {role.title}?</h3>
        <p>{compensationAnswer}</p>
      </div>
    </section>

    <!-- Back link -->
    <div class="role-back">
      <a href="/roles/" class="back-link">← All AI Roles</a>
    </div>

  </div>

</Layout>

<style>
.page-hero--compact {
  padding-bottom: var(--space-xl);
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.8rem;
  color: var(--text-secondary);
  margin-bottom: var(--space-lg);
  flex-wrap: wrap;
}

.breadcrumb a {
  color: var(--text-secondary);
  text-decoration: none;
}

.breadcrumb a:hover {
  color: var(--accent);
}

.breadcrumb-sep {
  color: var(--border);
}

.role-hero-header {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
  flex-wrap: wrap;
}

.role-hero-header h1 {
  font-size: 2rem;
  font-weight: 700;
  line-height: 1.2;
}

.role-status-badge {
  flex-shrink: 0;
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  font-family: var(--font-mono);
  padding: 0.3rem 0.7rem;
  border-radius: 4px;
  color: var(--status-color);
  background: color-mix(in srgb, var(--status-color) 12%, transparent);
  border: 1px solid color-mix(in srgb, var(--status-color) 30%, transparent);
  margin-top: 0.4rem;
}

.role-body {
  max-width: 800px;
  padding-top: var(--space-xl);
  padding-bottom: var(--space-2xl);
}

.role-section {
  margin-bottom: var(--space-2xl);
}

.role-section h2 {
  font-size: 1.15rem;
  font-weight: 600;
  margin-bottom: var(--space-md);
  color: var(--text-primary);
  padding-bottom: var(--space-sm);
  border-bottom: 1px solid var(--border-light);
}

.entry-paths-list {
  padding-left: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.entry-paths-list li {
  color: var(--text-secondary);
  font-size: 0.9rem;
  line-height: 1.5;
}

.skills-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.skill-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.5;
}

.skill-bullet {
  color: var(--accent);
  flex-shrink: 0;
  font-weight: 600;
}

.role-faq {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.role-faq h2 {
  margin-bottom: var(--space-lg);
}

.faq-item {
  padding: var(--space-lg) 0;
  border-bottom: 1px solid var(--border-light);
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-item h3 {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
}

.faq-item p {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

.role-back {
  margin-top: var(--space-xl);
  padding-top: var(--space-xl);
  border-top: 1px solid var(--border-light);
}

.back-link {
  font-size: 0.875rem;
  color: var(--accent);
  text-decoration: none;
  font-weight: 500;
}

.back-link:hover {
  text-decoration: underline;
}

@media (max-width: 600px) {
  .role-hero-header h1 {
    font-size: 1.5rem;
  }
}
</style>
