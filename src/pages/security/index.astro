---
import Layout from '../../layouts/Layout.astro'
import SecurityHero from '../../components/security/SecurityHero.astro'
import SecuritySubnav from '../../components/security/SecuritySubnav.astro'
import SecurityPathCards from '../../components/security/SecurityPathCards.astro'
import SecurityStats from '../../components/security/SecurityStats.astro'
import SecurityChecklist from '../../components/security/SecurityChecklist.astro'
import SecurityCodeExample from '../../components/security/SecurityCodeExample.astro'
import SecuritySourceList from '../../components/security/SecuritySourceList.astro'
import { SECURITY_DATA } from '../../data/security-data'
import { SECURITY_FEED, SECURITY_VIEW, getLatestSecurityEvents, getSecurityRoute } from '../../data/security-page'
import '../../styles/security-page.css'

const route = getSecurityRoute('hub')
const latestEvents = getLatestSecurityEvents(3)
const essentialSources = SECURITY_DATA.sources.slice(0, 8)
const jsonLd = [{ '@type': 'CollectionPage', name: route.heading, description: route.description, url: 'https://cc.bruniaux.com/security/', dateModified: SECURITY_FEED.intelligence.updated, author: { '@type': 'Person', '@id': 'https://cc.bruniaux.com/#author', name: 'Florian BRUNIAUX' } }]
---
<Layout title={route.title} description={route.description} jsonLd={jsonLd} compactFooter>
  <SecurityHero route={route} databaseLabel={SECURITY_VIEW.databaseLabel} databaseUpdatedLabel={SECURITY_VIEW.databaseUpdatedLabel}>
    <Fragment slot="actions"><a class="btn btn-primary" href="#agentsec-triage">Check a repository</a><a class="btn btn-secondary" href="#choose-path">Choose a path</a></Fragment>
    <div class="security-panel security-local-run"><div><p class="security-eyebrow">Local check</p><h2>Start with your repository</h2><p>Install AgentSec and run its current alpha scanner locally. This website does not receive or inspect your files.</p></div><SecurityCodeExample title={`AgentSec ${SECURITY_FEED.agentsec.version}`} code={SECURITY_FEED.agentsec.scan_command} /></div>
  </SecurityHero>
  <SecuritySubnav items={[{ href: '#security-stats', label: 'Evidence' }, { href: '#agentsec-triage', label: 'Local check' }, { href: '#choose-path', label: 'Paths' }, { href: '#latest-intelligence', label: 'Latest' }, { href: '#security-checklist', label: 'Checklist' }]} />
  <main>
    <section class="security-section" id="security-stats"><div class="security-shell"><div class="security-heading"><h2>Current evidence, with its date</h2><p>These values come from the bundled AgentSec feed and describe that database snapshot. They are not live measurements of the entire ecosystem.</p></div><SecurityStats stats={SECURITY_VIEW.stats} /></div></section>
    <section class="security-section security-section--alt" id="agentsec-triage"><div class="security-shell"><div class="security-heading"><h2>Verify your repository with AgentSec</h2><p>The scanner checks bounded repository inputs against bundled intelligence. A clean result is not proof of safety.</p></div><div class="security-card-grid"><article class="security-panel"><h3>1. Install</h3><p>Use the project’s documented installation path, then verify the installed version.</p><a class="security-text-link" href={SECURITY_FEED.agentsec.installation_url} target="_blank" rel="noopener noreferrer">Installation instructions →</a></article><article class="security-panel"><h3>2. Run locally</h3><p>Execute the scan inside the target repository. Review the exact files and evidence behind each finding.</p><a class="security-text-link" href={SECURITY_FEED.agentsec.repository_url} target="_blank" rel="noopener noreferrer">Inspect AgentSec source →</a></article><article class="security-panel"><h3>3. Respect the boundary</h3><p>Current detectors do not cover every host-level persistence mechanism, Git-history witness, or runtime behavior.</p><details><summary>{SECURITY_VIEW.detectors.length} detector records</summary><ul>{SECURITY_VIEW.detectors.map((detector) => <li><strong>{detector.id} v{detector.version}</strong>: {detector.description}</li>)}</ul></details></article></div></div></section>
    <section class="security-section" id="choose-path"><div class="security-shell"><div class="security-heading"><h2>Choose the task, not the scroll depth</h2><p>Each route answers one intent completely. The hub keeps orientation and current evidence without repeating every catalogue.</p></div><SecurityPathCards /></div></section>
    <section class="security-section security-section--alt" id="latest-intelligence"><div class="security-shell"><div class="security-heading"><h2>Latest sourced intelligence</h2><p>Three recent feed events, ordered by their canonical date. Follow the source before making a time-sensitive decision.</p></div><div class="security-event-grid">{latestEvents.map((event) => <article class="security-event"><time datetime={event.date}>{event.dateLabel}</time><h3>{event.title}</h3><p>{event.summary}</p><div class="security-event__sources">{event.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.publisher}</a>)}</div></article>)}</div><p><a class="security-text-link" href="/security/threats/#agentsec-intelligence">Open all threat intelligence →</a></p></div></section>
    <section class="security-section" id="security-checklist"><div class="security-shell"><div class="security-heading"><h2>Three checks before you continue</h2><p>Use this quick pass now. The full hardening route keeps the complete workstation and team checklist.</p></div><SecurityChecklist mode="quick" storageKey="security-hub-v1" /><p><a class="security-text-link" href="/security/hardening/#security-checklist">Open the complete checklist →</a></p></div></section>
    <section class="security-section security-section--alt" aria-labelledby="moved-content-title"><div class="security-shell"><div class="security-heading"><h2 id="moved-content-title">Looking for a section from the previous page?</h2><p>The content remains available at a focused destination. These anchors preserve old bookmarks and inbound links.</p></div><div class="security-card-grid">
      <a class="security-path-card" id="attack-techniques" href="/security/threats/#attack-techniques"><h3>Attack techniques</h3><p>Mechanisms, examples, campaigns, and mitigations.</p><span class="security-text-link">Open threats →</span></a>
      <a class="security-path-card" id="cve-database" href="/security/cves/#cve-database"><h3>CVE database</h3><p>Searchable vulnerabilities, fixed-version status, and mitigations.</p><span class="security-text-link">Open CVEs →</span></a>
      <a class="security-path-card" id="agentsec-intelligence" href="/security/threats/#agentsec-intelligence"><h3>AgentSec intelligence</h3><p>Dated event records and explicit detector coverage.</p><span class="security-text-link">Open intelligence →</span></a>
      <a class="security-path-card" id="active-campaigns" href="/security/threats/#active-campaigns"><h3>Active campaigns</h3><p>Tracked campaign records with reported dates and sources.</p><span class="security-text-link">Open campaigns →</span></a>
      <a class="security-path-card" id="threat-database" href="/security/threats/#threat-database"><h3>Threat database</h3><p>Filter events, campaigns, authors, and malicious skills.</p><span class="security-text-link">Search threats →</span></a>
      <a class="security-path-card" id="the-sandbox" href="/security/sandbox/#the-sandbox"><h3>The sandbox</h3><p>Protection boundaries, silent failures, configuration, and runtime checks.</p><span class="security-text-link">Configure sandbox →</span></a>
      <a class="security-path-card" id="defense-tools" href="/security/hardening/#defense-tools"><h3>Defense tools</h3><p>Capabilities and limits of the maintained scanner collection.</p><span class="security-text-link">Compare tools →</span></a>
      <a class="security-path-card" id="built-in-security-commands" href="/security/hardening/#built-in-security-commands"><h3>Built-in commands</h3><p>Quick checks, full audits, and the threat database terminal.</p><span class="security-text-link">Open commands →</span></a>
    </div></div></section>
    <div id="security-sources"><SecuritySourceList heading="Essential sources" sources={essentialSources} /></div>
  </main>
</Layout>
