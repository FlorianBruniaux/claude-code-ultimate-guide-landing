---
import Layout from '../../../layouts/Layout.astro'
import TerminalPlayground from '../../../components/global/TerminalPlayground.astro'
import SecurityBreadcrumbs from '../../../components/security/SecurityBreadcrumbs.astro'
import SecurityHero from '../../../components/security/SecurityHero.astro'
import SecuritySubnav from '../../../components/security/SecuritySubnav.astro'
import SecurityChecklist from '../../../components/security/SecurityChecklist.astro'
import SecurityCodeExample from '../../../components/security/SecurityCodeExample.astro'
import SecurityRelatedPages from '../../../components/security/SecurityRelatedPages.astro'
import { SECURITY_SUGGESTIONS } from '../../../scripts/bash-playground/suggestions'
import { SECURITY_DATA, type ScanningTool } from '../../../data/security-data'
import { SECURITY_FEED, SECURITY_VIEW, getSecurityRoute } from '../../../data/security-page'
import { getContextualLink } from '../../../data/seo-editorial-contract.mjs'
import '../../../styles/security-page.css'

const route = getSecurityRoute('hardening')
const command = SECURITY_FEED.agentsec.scan_command
const scanningTools: readonly ScanningTool[] = SECURITY_DATA.scanning_tools
const jsonLd = [{ '@type': 'HowTo', name: route.heading, description: route.description, url: 'https://cc.bruniaux.com/security/hardening/' }]
const permissionPatterns = getContextualLink('/cheatsheets/t04-permissions-glob-patterns/')
---
<Layout title={route.title} description={route.description} jsonLd={jsonLd} compactFooter>
  <SecurityBreadcrumbs route={route} />
  <SecurityHero route={route} databaseLabel={SECURITY_VIEW.databaseLabel} databaseUpdatedLabel={SECURITY_VIEW.databaseUpdatedLabel}>
    <Fragment slot="actions"><a class="btn btn-primary" href="#security-checklist">Start the checklist</a><a class="btn btn-secondary" href="#defense-tools">Compare tools</a></Fragment>
    <div class="security-panel"><h2>Three depths</h2><p><strong>5 minutes</strong> for immediate exposure, <strong>30 minutes</strong> for workstation controls, and <strong>Team controls</strong> for durable ownership.</p></div>
  </SecurityHero>
  <SecuritySubnav items={[{ href: '#paths', label: 'Paths' }, { href: '#defense-tools', label: 'Tools' }, { href: '#built-in-security-commands', label: 'Commands' }, { href: '#security-checklist', label: 'Checklist' }]} />
  <main>
    <section class="security-section" id="paths"><div class="security-shell"><div class="security-heading"><h2>Choose a hardening depth</h2><p>Start with the shortest path you can finish now, then continue without repeating the same checks.</p></div><div class="security-card-grid"><article class="security-panel"><p class="security-eyebrow">5 minutes</p><h3>Stop immediate exposure</h3><ul><li>Run the local AgentSec check.</li><li>Review hooks, skills, rules, and MCP configuration.</li><li>Remove unpinned or unexplained dependencies.</li></ul></article><article class="security-panel"><p class="security-eyebrow">30 minutes</p><h3>Harden the workstation</h3><ul><li>Restrict permissions and sandbox boundaries.</li><li>Block credential paths and environment variables.</li><li><a href={permissionPatterns.target}>{permissionPatterns.anchor}</a> before testing network and filesystem denials at runtime.</li></ul></article><article class="security-panel"><p class="security-eyebrow">Team controls</p><h3>Make the baseline repeatable</h3><ul><li>Assign owners and review paths.</li><li>Pin versions and validate upgrades.</li><li>Automate checks without auto-approving findings.</li></ul></article></div></div></section>
    <section class="security-section security-section--alt" id="agentsec-local"><div class="security-shell"><div class="security-heading"><h2>Run AgentSec locally</h2><p>The page does not inspect your repository. Install AgentSec, run it in the repository, and review its bounded findings.</p></div><SecurityCodeExample title={`AgentSec ${SECURITY_FEED.agentsec.version} (${SECURITY_FEED.agentsec.status})`} code={command} /><p class="security-callout">A clean result is not a security guarantee. The scanner does not inspect every host-level, historical, or runtime surface.</p></div></section>
    <section class="security-section" id="defense-tools"><div class="security-shell"><div class="security-heading"><h2>Defense tools</h2><p>Choose by coverage and limits, not by logo count. Each record keeps its stated capabilities and limitations.</p></div><div class="security-card-grid">{scanningTools.map((tool) => <article class="security-panel"><p class="security-eyebrow">{tool.type}</p><h3>{tool.name}</h3><p>{tool.vendor}</p><ul>{tool.capabilities.slice(0, 3).map((item) => <li>{item}</li>)}</ul><details><summary>Limits</summary><ul>{tool.limitations.map((item) => <li>{item}</li>)}</ul></details>{tool.url && <a class="security-text-link" href={tool.url} target="_blank" rel="noopener noreferrer">Open tool →</a>}</article>)}</div></div></section>
    <section class="security-section security-section--alt" id="built-in-security-commands"><div class="security-shell"><div class="security-heading"><h2>Built-in security commands</h2><p>Use a quick check for known configuration risks, then a broader audit when you need permissions, hooks, secrets, and supply-chain coverage.</p></div><div class="security-card-grid"><SecurityCodeExample title="Quick configuration scan" code="/security-check" /><SecurityCodeExample title="Full six-phase assessment" code="/security-audit" /></div><TerminalPlayground id="securityTerminal" summaryLabel="Explore the threat database with jq" titlebarLabel="bash: threat-db.json" payloadUrl="/security-fs.json" banner="Threat database explorer: real jq over the real CVE/campaign data." suggestions={SECURITY_SUGGESTIONS} fallbackLinkHref="/security/cves/" fallbackLinkLabel="the CVE database" /></div></section>
    <section class="security-section" id="security-checklist"><div class="security-shell"><div class="security-heading"><h2>Complete hardening checklist</h2><p>Progress is stored locally when browser storage is available. The checklist remains usable when storage is blocked.</p></div><SecurityChecklist mode="full" storageKey="security-hardening-v1" /></div></section>
  </main>
  <SecurityRelatedPages current="hardening" />
</Layout>
