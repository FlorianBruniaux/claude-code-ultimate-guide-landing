---
import Layout from '../../layouts/Layout.astro'
import { glossaryTerms, groupByLetter, categoryColors } from '../../data/glossary-data'
import { normalizeGlossarySlug } from '../../scripts/glossary-tooltips'
import { getGlossaryTitle, landingSeo } from '../../data/seo-editorial-contract.mjs'

const { description } = landingSeo.glossary
const title = getGlossaryTitle(glossaryTerms.length)

const grouped = groupByLetter(glossaryTerms)
const letters = Array.from(grouped.keys()).sort()
const totalTerms = glossaryTerms.length

const jsonLd = [
  {
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": "https://cc.bruniaux.com/glossary/",
    "datePublished": "2026-03-25",
    "dateModified": "2026-03-25",
    "inLanguage": "en",
    "isPartOf": {
      "@type": "WebSite",
      "name": "Claude Code Ultimate Guide",
      "url": "https://cc.bruniaux.com/"
    },
    "author": {
      "@type": "Person",
      "name": "Florian Bruniaux",
      "url": "https://github.com/FlorianBruniaux"
    }
  },
  {
    "@type": "DefinedTermSet",
    "name": "Claude Code Glossary",
    "url": "https://cc.bruniaux.com/glossary/",
    "hasDefinedTerm": glossaryTerms.slice(0, 20).map(t => ({
      "@type": "DefinedTerm",
      "name": t.term,
      "description": t.definition,
    }))
  }
]
import ChapterLabel from '../../components/global/ChapterLabel.astro'
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <div class="hero-badge">Reference</div>
      <h1>Claude Code glossary</h1>
      <p class="hero-subtitle">
        {totalTerms} terms: Claude Code concepts, community patterns, and AI engineering vocabulary.
        Standard CS terms (JWT, CI/CD, REST) are excluded.
      </p>

      <!-- Quick alphabet nav -->
      <nav class="alpha-nav" aria-label="Jump to letter">
        {letters.map(letter => (
          <a href={`#letter-${letter}`} class="alpha-link">{letter}</a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Main content -->
  <section class="band band-base glossary-section">
    <div class="container">
      <ChapterLabel number="01" label="Terms A to Z" />
      {letters.map(letter => {
        const terms = grouped.get(letter)!
        return (
          <div class="letter-group" id={`letter-${letter}`}>
            <h2 class="letter-heading">
              <span class="letter-char">{letter}</span>
              <span class="letter-count">{terms.length}</span>
            </h2>
            <div class="terms-list">
              {terms.map(t => (
                <div class="term-row" data-cat={t.category}>
                  <div class="term-left">
                    <h3 class="term-name">
                      <a href={`/glossary/${normalizeGlossarySlug(t.term)}/`} class="term-link">{t.term}</a>
                    </h3>
                    <div class="term-meta">
                      <span class={`badge ${categoryColors[t.category] ?? 'badge-default'}`}>{t.category}</span>
                      <span class="badge badge-sub">{t.subcategory}</span>
                    </div>
                  </div>
                  <p class="term-def">{t.definition}</p>
                </div>
              ))}
            </div>
          </div>
        )
      })}
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="band band-ink section-wallpaper glossary-cta">
    <div class="container">
      <p>Full context in the <a href="/guide/" class="cta-link">Ultimate Guide</a>, or contribute a missing term on <a href="https://github.com/FlorianBruniaux/claude-code-ultimate-guide/issues" target="_blank" rel="noopener noreferrer" class="cta-link">GitHub</a>.</p>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ── */
  .page-hero {
    padding: 4rem 0 3rem;
  }
  .hero-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-control);
    margin-bottom: 1rem;
  }
  .page-hero h1 { margin: 0 0 0.75rem; }
  .hero-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 540px;
    margin: 0 0 2rem;
    line-height: 1.65;
  }

  /* ── Alphabet nav ── */
  .alpha-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .alpha-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--radius-control);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    border: 1px solid var(--border);
    text-decoration: none;
    transition: color 0.12s, border-color 0.12s, background 0.12s;
  }
  .alpha-link:hover {
    color: var(--bg-primary);
    border-color: var(--text-primary);
    background: var(--text-primary);
  }
  .alpha-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* ── Glossary section ── */
  .glossary-section {
    padding: 3rem 0 5rem;
  }

  /* ── Letter group ── */
  .letter-group {
    margin-bottom: 2.5rem;
    scroll-margin-top: 5rem;
  }
  .letter-heading {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.6rem;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    padding: 0.6rem 1rem;
    background: var(--band-ink-background, #191b1d);
    border-left: 3px solid var(--action, var(--accent));
    border-radius: var(--radius-control) var(--radius-control) 0 0;
    margin-bottom: 0;
  }
  .letter-char {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--action, var(--accent));
    line-height: 1;
    min-width: 1ch;
  }
  .letter-count {
    font-size: 0.7rem;
    font-weight: 600;
    color: #f4efe4;
    background: var(--band-ink-surface, #292c30);
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-control);
    margin-left: auto;
  }

  /* ── Term list ── */
  .terms-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--border);
    border-top: 0;
    border-radius: 0 0 var(--border-radius-lg) var(--border-radius-lg);
    background: var(--surface-elevated);
    overflow: hidden;
  }
  .term-row {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 0 2rem;
    padding: 0.9rem 1.25rem 0.9rem 0.85rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent);
    border-left: 3px solid transparent;
    align-items: start;
    transition: background-color 120ms ease;
  }
  .term-row:last-child {
    border-bottom: none;
  }
  .term-row:nth-child(even) {
    background: color-mix(in srgb, currentColor 4%, transparent);
  }
  .term-row:hover {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  /* Category left-border colors */
  .term-row[data-cat="Claude Code"]   { border-left-color: #3b82f6; }
  .term-row[data-cat="AI"]            { border-left-color: #ec4899; }
  .term-row[data-cat="Workflow"]      { border-left-color: #10b981; }
  .term-row[data-cat="Security"]      { border-left-color: #ef4444; }
  .term-row[data-cat="Models"]        { border-left-color: #8b5cf6; }
  .term-row[data-cat="Ecosystem"]     { border-left-color: #f59e0b; }
  .term-row[data-cat="Methodology"]   { border-left-color: #6b7280; }
  .term-row[data-cat="Architecture"]  { border-left-color: #0ea5e9; }
  .term-row[data-cat="Operations"]    { border-left-color: #22c55e; }

  /* ── Term left (name + badge) ── */
  .term-left {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-right: 0.5rem;
  }
  .term-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.35;
    word-break: break-word;
    font-family: inherit;
  }
  .term-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .term-link:hover {
    text-decoration-thickness: 2px;
  }
  .term-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
  }

  /* ── Term definition ── */
  .term-def {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.7;
  }

  /* ── Badges ── */
  .badge {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-control);
    white-space: nowrap;
  }
  .badge-sub {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }
  .badge-cc       { background: #dbeafe; color: #1e40af; }
  .badge-ai       { background: #fce7f3; color: #9d174d; }
  .badge-workflow { background: #d1fae5; color: #065f46; }
  .badge-security { background: #fee2e2; color: #991b1b; }
  .badge-models   { background: #ede9fe; color: #5b21b6; }
  .badge-ecosystem { background: #fef3c7; color: #92400e; }
  .badge-methodology { background: #f3f4f6; color: #374151; }
  .badge-arch     { background: #e0f2fe; color: #075985; }
  .badge-ops      { background: #f0fdf4; color: #14532d; }
  .badge-default  { background: transparent; color: var(--text-secondary); border: 1px solid var(--border); }

  :global(.dark) .badge-cc       { background: rgba(30,58,95,0.8);  color: #93c5fd; }
  :global(.dark) .badge-ai       { background: rgba(74,25,66,0.8);  color: #f9a8d4; }
  :global(.dark) .badge-workflow { background: rgba(6,78,59,0.8);   color: #6ee7b7; }
  :global(.dark) .badge-security { background: rgba(69,10,10,0.8);  color: #fca5a5; }
  :global(.dark) .badge-models   { background: rgba(46,16,101,0.8); color: #c4b5fd; }
  :global(.dark) .badge-ecosystem { background: rgba(69,26,3,0.8);  color: #fcd34d; }
  :global(.dark) .badge-methodology { background: rgba(31,41,55,0.8); color: #d1d5db; }
  :global(.dark) .badge-arch     { background: rgba(12,74,110,0.8); color: #7dd3fc; }
  :global(.dark) .badge-ops      { background: rgba(5,46,22,0.8);   color: #86efac; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .term-row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding: 0.9rem 0.85rem;
    }
    .alpha-link {
      width: 1.9rem;
      height: 1.9rem;
      font-size: 0.78rem;
    }
  }

  /* ── CTA ── */
  .glossary-cta {
    padding: 3rem 0 4rem;
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }
  .cta-link {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cta-link:hover { text-decoration-thickness: 2px; }
</style>
